From b84475c0ca60458f4c260ab1fc9247a2fa028c35 Mon Sep 17 00:00:00 2001
From: coop-fetch <coop-fetch@localhost>
Date: Sun, 22 Nov 2026 05:00:00 -0900
Subject: [PATCH] Co-op boss orders wrap: Twinrova's battle manager orders to
 the module

One more wrapped game function in patch 0005's table
(nx2/coop_world_wraps.py WRAPS; its id in host/hos_coop_boss_orders.h), for
oot-remake-multiplayer's row 222 (docs/dungeons-boss.md "Battle manager
orders"):
- 10: main+0x2723f80, the message handler of the AI node
  ExecuteKotakeKoumeReceiveMessageProc (vtable main+0x49a8568 slot 39), where
  Kotake and Koume take their battle manager's orders (0x70210000,
  0x70210001).
The owner's game runs its manager; the module sends each order and puts it
into the other games' sisters through the same function, whose own
manager's orders it skips there (phase 0 answers 1). Nothing else changes:
the wrap machinery, the checks (build id, first words) and the hello's bits
are 0005's.
---
 host/hos_coop_boss_orders.h | 20 ++++++++++++++++++++
 nx2/coop_world_wraps.py     |  6 ++++++
 2 files changed, 26 insertions(+)
 create mode 100644 host/hos_coop_boss_orders.h

diff --git a/host/hos_coop_boss_orders.h b/host/hos_coop_boss_orders.h
new file mode 100644
index 00000000..2a1a7366
--- /dev/null
+++ b/host/hos_coop_boss_orders.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   A battle manager's orders, on Hookshot (oot-remake-multiplayer, docs/dungeons-boss.md "Battle manager orders").
+
+   One wrapped game function more in the one wrap table (patch 0005's nx2/coop_world_wraps.py WRAPS; the ids are in
+   the one wrap space of hos_coop_world.h). Patch 0036 adds its row and this file (Hookshot's host/hos_coop_boss_orders.h
+   is the same file). The module's hos_coop_wrap gets it; Hookshot announces it in HOS_COOP_WORLD_HELLO's bits. The row:
+     (10, 0x2723f80, (0xd503237f, 0xd10103ff, 0xa9027bfd, 0xa9034ff4)),  # pacibsp; sub sp, #0x40; stp x29, x30; stp x20, x19
+   Phase 0 may return 1 (skip); the module then sets x0 to 1, what the function always returns. Plain C. */
+#ifndef HOS_COOP_BOSS_ORDERS_H
+#define HOS_COOP_BOSS_ORDERS_H
+
+/* main+0x2723f80, the message handler of the AI node ExecuteKotakeKoumeReceiveMessageProc (vtable main+0x49a8568,
+   slot 39; called through the node's receiver at +0x20, main+0x27240e0): Twinrova's sisters Kotake and Koume take
+   their battle manager's orders here (Enemy_KotakeKoumeBattleManager's ExecuteKotakeKoumeBattleManagerAI posts them
+   through the game's message manager, main+0x379740). x0 the node, x1 the message: +0 the sender's actor id, +4 the
+   type, +0x10 the payload. Types 0x70210000 (battle state, roll type, attack start place, main move) and 0x70210001
+   (under the interval threshold) are written into the sister's blackboard; others are not read. Returns 1. */
+#define HOS_COOP_WRAP_BOSS_ORDER 10u
+
+#endif
diff --git a/nx2/coop_world_wraps.py b/nx2/coop_world_wraps.py
index 20aca8a9..c1485d9c 100644
--- a/nx2/coop_world_wraps.py
+++ b/nx2/coop_world_wraps.py
@@ -52,6 +52,12 @@ WRAPS = (
     # main+0x4ba4a28 slot 29, only called through it), which only Game Over's graphs run (Retry: Try Again,
     # EventToTitle: Quit Game). A save load after it with no title menu between is Try Again. Phase 0 reads only
     (9, 0x32bbce0, (0xd503237f, 0xa9be7bfd, 0xf9000bf3, 0x910003fd)),  # pacibsp; stp x29, x30; str x19; mov x29, sp
+    # HOS_COOP_WRAP_BOSS_ORDER (patch 0036): the message handler of the AI node ExecuteKotakeKoumeReceiveMessageProc
+    # (vtable main+0x49a8568 slot 39, called through the node's receiver): Twinrova's sisters take their battle
+    # manager's orders (types 0x70210000, 0x70210001). x0 the node, x1 the message. The owner's game sends its orders;
+    # the others' copies take them through this same function, whose own manager's orders it skips there (phase 0
+    # answers 1; the function returns 1)
+    (10, 0x2723f80, (0xd503237f, 0xd10103ff, 0xa9027bfd, 0xa9034ff4)),  # pacibsp; sub sp, #0x40; stp x29, x30; stp x20, x19
 )
 
 
