+/// The module's tabs in the menu (hos_coop_menu.h), first in its strip: how many (0 without the module, or an older one)
+constexpr int kMaxMenuTabs = 4;
+int menu_tabs();
+/// A tab's name in the strip ("" none)
+const char *menu_tab_name(int tab);
+/// The tab's page as the module has it now: its rows, the selection, the help box and the prompts' words (false: none)
+bool menu_page(int tab, HosCoopMenuPage *out);
+/// A press on the tab, or the mouse (HOS_COOP_MENU_*): whether the module took it
+bool menu_input(int tab, int event, int arg = 0, int arg2 = 0);
+/// What the module wants of the menu now: HOS_COOP_MENU_WANT_NOTHING, _CLOSE, or a tab to open on
+int menu_wanted();
+
 }  // namespace mkwvk::coop
