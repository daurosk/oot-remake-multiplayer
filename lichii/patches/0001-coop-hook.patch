@@ -6402,6 +6409,11 @@ void MainWindow::closeEvent(QCloseEvent* event) {
     LOG_INFO(Frontend, "Closing frontend after emulation cleanup");
     // Watched from here on also when no game ran (Begin arms it, or names the step).
     Common::ShutdownWatch::Begin("frontend close: saving settings");
+#ifdef LICHII_COOP
+    Common::ShutdownWatch::Step("frontend close: co-op");
+    CoopHook::Shutdown();
+    Common::ShutdownWatch::Step("frontend close: saving settings");
+#endif
 
     UpdateUISettings();
     game_list->SaveInterfaceLayout();
