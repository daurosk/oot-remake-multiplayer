+    coop_turn_fn = (hos_coop_turn_fn)(void *)GetProcAddress(m, "hos_coop_turn");
     coop_title_hold = (int (*)(void))(void *)GetProcAddress(m, "hos_coop_title_hold");
     coop_game_screen = (void (*)(void *, uint64_t))(void *)GetProcAddress(m, "hos_coop_game_screen");
     coop_pause_page = (int (*)(void))(void *)GetProcAddress(m, "hos_coop_game_pause_page");
@@ -273,6 +276,11 @@ int hos_coop_view_filter(double eye[3], double target[3]) {
     return __atomic_load_n(&state, __ATOMIC_ACQUIRE) == 2 && coop_view ? coop_view(eye, target) : 0;
 }
 
+/* mouse_native.c hos_mouse_camera: the player camera's yaw and pitch for the module first (hos_coop_turn.h); 1 = replaced */
+int hos_coop_turn_filter(float *yaw, float *pitch, int camera_state) {
+    return __atomic_load_n(&state, __ATOMIC_ACQUIRE) == 2 && coop_turn_fn ? coop_turn_fn(yaw, pitch, camera_state) : 0;
+}
