From bdc79eff16ddfb1b7ec5b4103c983c7f95839883 Mon Sep 17 00:00:00 2001
From: daurosk <354202035+daurosk@users.noreply.github.com>
Date: Fri, 13 Nov 2026 23:43:07 -0900
Subject: [PATCH] Co-op menu language: the menu's language for the module's
 tabs

gpu/vk/vk_menu_i18n.cpp exports hos_coop_menu_lang: the code of the
language this menu shows now (lang_code(): the Menu language row, Auto
the game's own). The co-op module draws its tabs in this menu, so it
asks it which language to use, the one the menu merged the glyphs for;
a renderer without the export leaves the module on language.txt.
---
 gpu/vk/vk_menu_i18n.cpp | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/gpu/vk/vk_menu_i18n.cpp b/gpu/vk/vk_menu_i18n.cpp
index cf38760e..8ae39540 100644
--- a/gpu/vk/vk_menu_i18n.cpp
+++ b/gpu/vk/vk_menu_i18n.cpp
@@ -295,3 +295,17 @@ const char* tr(const char* s) {
 }
 
 }  // namespace mkwvk::i18n
+
+// (co-op, oot-remake-multiplayer patch 0021) The menu's language now (lang_code(): the Menu language row, Auto the game's
+// own), for a co-op module whose tabs are drawn in this menu: it shows its words in the same language, the one this menu
+// merged the glyphs for (vk_imgui.cpp script_fonts). Looked up by name in longshot_vk, so a module on a renderer without
+// it keeps its own reading of language.txt. The text lives for the process.
+extern "C"
+#ifdef _WIN32
+__declspec(dllexport)
+#else
+__attribute__((visibility("default")))
+#endif
+const char* hos_coop_menu_lang(void) {
+    return mkwvk::i18n::lang_code();
+}
-- 
