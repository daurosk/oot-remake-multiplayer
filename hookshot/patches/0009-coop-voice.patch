 host/hos_coop_voice.h |  58 ++++++++++++++++
 host/nn_audio.c       |  12 ++++
 host/nn_audio_in.c    | 149 +++++++++++++++++++++++++++++++++++++++---
 4 files changed, 330 insertions(+), 9 deletions(-)
 create mode 100644 host/coop_voice.c
