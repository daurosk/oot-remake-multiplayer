 #include <cmath>
@@ -1590,6 +1593,20 @@ void outputs_sync() {
 
 int cur_tab = TAB_GRAPHICS;
 int tab_selected[TAB_COUNT + 1] = {};   // (and the Motion page's)
+// (oot-remake-multiplayer) The co-op module's tabs (vk_coop.h, hos_coop_menu.h), first in the strip: how many it has (asked
