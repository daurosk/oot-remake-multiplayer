+/* (oot-remake-multiplayer's patch 0010, local co-op) For hookshot_coop.dll, found by name in this exe (GetProcAddress
+   on the exe; its hookshot/src/hos_coop_pads.h). The SDL pads one by one, slot 0 and up:
+   - hos_coop_pad_info: -1 past the last slot; 0 no pad in the slot; 1 a pad: its serial (which opening: a pad that
+     reconnects is a new one), its name, and the Npad a local player took it as (0 none, 1 to 3: No.2 to No.4);
+   - hos_coop_pad_read: its buttons as the game would get them (Switch NpadButton bits, the menu's binds) and its
+     sticks (left x, y, right x, y), taken or not, any thread (the Local co-op page's "press A to join"); 1 when open;
+   - hos_coop_pad_take: npad 1 to 3 makes the pad of that serial Npad No.2 to No.4 (left out of player 1's merged
+     pad; another pad that was that Npad is given back), 0 gives it back; 1 when done. */
+#ifdef _WIN32
+#define HOS_COOP_HID_EXPORT __declspec(dllexport)
+#else
+#define HOS_COOP_HID_EXPORT __attribute__((visibility("default")))
+#endif
+HOS_COOP_HID_EXPORT int hos_coop_pad_info(int slot, uint32_t *serial, char *name, size_t cap, int *npad) {
+    return hos_sdl_pad_slot(slot, serial, name, cap, NULL, NULL, npad);
+}
+HOS_COOP_HID_EXPORT int hos_coop_pad_read(int slot, uint64_t *buttons, int32_t stick[4]) {
+    uint64_t raw = 0;
+    int32_t s[4] = {0};
+    const int open = hos_sdl_pad_slot(slot, NULL, NULL, 0, &raw, s, NULL) > 0;
+    if (buttons) *buttons = open ? local_pad_buttons(raw) : 0;
+    if (stick) memcpy(stick, s, sizeof s);
+    return open;
+}
+HOS_COOP_HID_EXPORT int hos_coop_pad_take(int slot, uint32_t serial, int npad) { return hos_sdl_pad_take(slot, serial, npad); }
