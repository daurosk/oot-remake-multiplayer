Subject: [PATCH 2/5] coop: hand the game's camera to the co-op hook

With LICHII_COOP on, each draw calls CoopCamera::Track from the hook's
coop_camera_track.h after its pipeline is configured. It looks for the same
camera buffer as the DLSS path (TrackOcarinaCamera) without needing DLSS,
so co-op can draw player markers in the world.
---
 src/video_core/renderer_vulkan/vk_rasterizer.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
index 7d973646f4..3d3168469e 100644
--- a/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -81,6 +81,9 @@
 #include "video_core/nx2_debug_control.h"
 #include "video_core/nx2_perf.h"
 #include "video_core/nx2_profile.h"
+#ifdef LICHII_COOP
+#include "coop_camera_track.h"
+#endif
 
 namespace Vulkan {
 
@@ -892,6 +895,10 @@ void RasterizerVulkan::PrepareDraw(bool is_indexed, Func&& draw_func, bool is_in
         return;
     }
 
+#ifdef LICHII_COOP
+    CoopCamera::Track(texture_cache, buffer_cache, device_memory, maxwell3d->regs,
+                      render_trace_frame);
+#endif
     TrackOcarinaCamera();
     TrackOcarinaActor(pipeline->ShaderHashes()[1], is_indexed, is_indirect);
     TracePendingCpuWrites(false, pipeline->ShaderHashes());
