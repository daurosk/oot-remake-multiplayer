From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: daurosk <354202035+daurosk@users.noreply.github.com>
Date: Sun, 8 Nov 2026 15:53:31 -0900
Subject: [PATCH] coop: optional hooks for OoT co-op

Adds LICHII_COOP (off by default). When on, the build adds the co-op
libraries from LICHII_COOP_DIR (an oot-remake-multiplayer checkout) and
includes its lichii/hook/core.cmake and qt.cmake, which build the hook into
core and the co-op panel into the Qt frontend. CoopHook::OnFrame runs once
per guest present, in both present paths (nx2 and nvdisp), after the speed
limiter. The main window starts co-op once the render window exists and
stops it when it closes.
---
 CMakeLists.txt                                   | 16 ++++++++++++++++
 src/core/CMakeLists.txt                          |  4 ++++
 .../hle/service/nvdrv/devices/nvdisp_disp0.cpp   |  6 ++++++
 src/core/hle/service/nx2_gsv.h                   |  6 ++++++
 src/yuzu/CMakeLists.txt                          |  4 ++++
 src/yuzu/main_window.cpp                         | 10 ++++++++++
 6 files changed, 46 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8e847462b0..cc4ab7bdce 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -728,6 +728,22 @@ if (MSVC AND CXX_CLANG)
     link_libraries(llvm-mingw-runtime)
 endif()
 
+# OoT co-op (github.com/daurosk/oot-remake-multiplayer). Off unless asked for.
+option(LICHII_COOP "Build in the OoT co-op hook from LICHII_COOP_DIR" OFF)
+if (LICHII_COOP)
+    set(LICHII_COOP_DIR "" CACHE PATH "Checkout of oot-remake-multiplayer")
+    if (NOT EXISTS "${LICHII_COOP_DIR}/lichii/hook/coop_hook.cpp")
+        message(FATAL_ERROR "LICHII_COOP_DIR must point at an oot-remake-multiplayer checkout")
+    endif()
+    # Fritchii's updater would install a plain release over the co-op build.
+    if (ENABLE_UPDATE_CHECKER)
+        message(FATAL_ERROR "LICHII_COOP needs ENABLE_UPDATE_CHECKER=OFF")
+    endif()
+    set(COOP_BUILD_TESTS OFF)
+    set(COOP_BUILD_PROGRAMS OFF)
+    add_subdirectory("${LICHII_COOP_DIR}" "${CMAKE_BINARY_DIR}/coop" EXCLUDE_FROM_ALL)
+endif()
+
 add_subdirectory(src)
 
 if (ENABLE_DEBUG_TOOLS)
diff --git a/src/core/CMakeLists.txt b/src/core/CMakeLists.txt
index c229ee21c8..a1df9c8e5a 100644
--- a/src/core/CMakeLists.txt
+++ b/src/core/CMakeLists.txt
@@ -1320,4 +1320,8 @@ elseif (MSVC AND CMAKE_CXX_COMPILER_ID MATCHES "Clang" AND CMAKE_CXX_FLAGS_RELEA
     set_source_files_properties(${lichii_kernel_sources} PROPERTIES COMPILE_OPTIONS -fno-lto)
 endif()
 
+if (LICHII_COOP)
+    include("${LICHII_COOP_DIR}/lichii/hook/core.cmake")
+endif()
+
 create_target_directory_groups(core)
diff --git a/src/core/hle/service/nvdrv/devices/nvdisp_disp0.cpp b/src/core/hle/service/nvdrv/devices/nvdisp_disp0.cpp
index b8a8979315..b7c3d805df 100644
--- a/src/core/hle/service/nvdrv/devices/nvdisp_disp0.cpp
+++ b/src/core/hle/service/nvdrv/devices/nvdisp_disp0.cpp
@@ -16,6 +16,9 @@
 #include "core/hle/service/nvdrv/devices/nvdisp_disp0.h"
 #include "core/perf_stats.h"
 #include "video_core/gpu.h"
+#ifdef LICHII_COOP
+#include "coop_hook.h"
+#endif
 
 namespace Service::Nvidia::Devices {
 
@@ -92,6 +95,9 @@ void nvdisp_disp0::Composite(std::span<const Nvnflinger::HwcLayer> sorted_layers
     system.SpeedLimiter().DoSpeedLimiting(system.CoreTiming().GetGlobalTimeUs());
     system.GetPerfStats().EndSystemFrame();
     system.GetPerfStats().BeginSystemFrame();
+#ifdef LICHII_COOP
+    CoopHook::OnFrame(system);
+#endif
 }
 
 void nvdisp_disp0::WaitForComposite() {
diff --git a/src/core/hle/service/nx2_gsv.h b/src/core/hle/service/nx2_gsv.h
index 7b0f3006e1..1e93b157ff 100644
--- a/src/core/hle/service/nx2_gsv.h
+++ b/src/core/hle/service/nx2_gsv.h
@@ -82,6 +82,9 @@
 #include "core/hle/service/sm/sm.h"
 #include "core/hle/service/server_manager.h"
 #include "core/hle/service/service.h"
+#ifdef LICHII_COOP
+#include "coop_hook.h"
+#endif
 
 namespace Service {
 
@@ -2427,6 +2430,9 @@ private:
         system.SpeedLimiter().DoSpeedLimiting(system.CoreTiming().GetGlobalTimeUs());
         system.GetPerfStats().EndSystemFrame();
         system.GetPerfStats().BeginSystemFrame();
+#ifdef LICHII_COOP
