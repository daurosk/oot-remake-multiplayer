+// (the module's tabs in the menu, hos_coop_menu.h: all four exports or none; looked for every 60 asks until found, as
+// find() above, from the menu's tick and the present's thread alike)
+namespace {
+std::atomic<hos_coop_menu_tabs_fn> menu_tabs_fn{nullptr};
+std::atomic<hos_coop_menu_tab_name_fn> menu_tab_name_fn{nullptr};
+std::atomic<hos_coop_menu_page_fn> menu_page_fn{nullptr};
+std::atomic<hos_coop_menu_input_fn> menu_input_fn{nullptr};
+std::atomic<hos_coop_menu_wanted_fn> menu_wanted_fn{nullptr};
+
+void find_menu() {
+    static std::atomic<int> wait{0};
+    if (menu_tabs_fn.load(std::memory_order_acquire) || wait.fetch_sub(1, std::memory_order_relaxed) > 0) return;
+    wait.store(60, std::memory_order_relaxed);
+#ifdef _WIN32
+    HMODULE m = GetModuleHandleA("hookshot_coop.dll");
+    if (!m) return;
+    auto look = [m](const char *name) { return (void *)GetProcAddress(m, name); };
+#else
+    void *m = dlopen("hookshot_coop.so", RTLD_NOW | RTLD_NOLOAD);
+    auto look = [m](const char *name) { return m ? dlsym(m, name) : dlsym(RTLD_DEFAULT, name); };
+#endif
+    auto t = (hos_coop_menu_tabs_fn)look("hos_coop_menu_tabs");
+    auto n = (hos_coop_menu_tab_name_fn)look("hos_coop_menu_tab_name");
+    auto p = (hos_coop_menu_page_fn)look("hos_coop_menu_page");
+    auto i = (hos_coop_menu_input_fn)look("hos_coop_menu_input");
+    if (!t || !n || !p || !i) return;   // (an older module: no tabs)
+    menu_tab_name_fn.store(n, std::memory_order_release);
+    menu_page_fn.store(p, std::memory_order_release);
+    menu_input_fn.store(i, std::memory_order_release);
+    menu_wanted_fn.store((hos_coop_menu_wanted_fn)look("hos_coop_menu_wanted"), std::memory_order_release);
+    menu_tabs_fn.store(t, std::memory_order_release);
+    logf("vk: co-op: the module's menu tabs found");
+}
+}  // namespace
+
+int menu_tabs() {
+    find_menu();
+    const auto t = menu_tabs_fn.load(std::memory_order_acquire);
+    return t ? std::clamp(t(), 0, kMaxMenuTabs) : 0;
+}
+
+const char *menu_tab_name(int tab) {
+    const auto n = menu_tab_name_fn.load(std::memory_order_acquire);
+    const char *name = n ? n(tab) : nullptr;
+    return name ? name : "";
+}
+
+bool menu_page(int tab, HosCoopMenuPage *out) {
+    const auto p = menu_page_fn.load(std::memory_order_acquire);
+    if (!p || !out) return false;
+    *out = HosCoopMenuPage{};
+    out->size = sizeof *out;
+    out->selected = -1;
+    if (!p(tab, out)) return false;
+    if (out->rows_n < 0 || !out->rows) out->rows_n = 0;
+    if (out->selected >= out->rows_n) out->selected = -1;
+    return true;
+}
+
+bool menu_input(int tab, int event, int arg, int arg2) {
+    const auto i = menu_input_fn.load(std::memory_order_acquire);
+    return i && i(tab, event, arg, arg2) != 0;
+}
+
+int menu_wanted() {
+    const auto w = menu_wanted_fn.load(std::memory_order_acquire);
+    return w ? w() : HOS_COOP_MENU_WANT_NOTHING;
+}
+
 }  // namespace mkwvk::coop
