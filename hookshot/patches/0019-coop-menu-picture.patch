diff --git a/host/hos_coop_view.h b/host/hos_coop_view.h
new file mode 100644
index 00000000..2e7b586d
--- /dev/null
+++ b/host/hos_coop_view.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   The co-op module may frame the game's camera (oot-remake-multiplayer, docs/hookshot.md "The Multiplayer tab"; our
+   patch 0019): the Multiplayer tab's Customize page turns the gameplay camera slowly around the player's own Link, shown
+   through a clear window in the menu (hos_coop_menu_picture.h, `live`).
+
+   One optional export, hos_coop_view, asked by hos_oot_free_view (host/hos_main.c) on the game's thread each time the
+   game builds its gameplay view, before the Debug tab's free camera. It gets the game's own eye and target (metres, the
+   world's axes, y up) and may replace them: 1 = the camera looks from `eye` at `target` this frame (the game's own
+   matrix is rebuilt from them, as the free camera's is), 0 = the game's camera as it is. A module without it: the game's
+   camera always. Generic: any module may frame the camera, with no further Hookshot build.
+   The same file is in Hookshot's host/ through our patch and in our repository (hookshot/src): keep them equal
+   (tests/hookshot/module_test.cpp checks it). Plain C. */
+#ifndef HOS_COOP_VIEW_H
+#define HOS_COOP_VIEW_H
+
+typedef int (*hos_coop_view_fn)(double eye[3], double target[3]);   /* 1: replaced */
+
+#endif
diff --git a/host/hos_main.c b/host/hos_main.c
index a78c1905..1737168e 100644
--- a/host/hos_main.c
+++ b/host/hos_main.c
@@ -1619,6 +1619,33 @@ static void oot_build_free_view(Ctx *c, uint64_t view, uint64_t out) {
         }
     }
 }
+
+/* (oot-remake-multiplayer, patch 0019) The co-op module's camera (hos_coop_view.h): it gets the game's eye and target and
+   may give others; then the gameplay view is built from them as the free camera builds its own (right, up, back rows, the
+   eye's offset in the fourth column). 1: the module framed it */
+static int oot_coop_view(Ctx *c, uint64_t view) {
+    int hos_coop_view_filter(double eye[3], double target[3]);
+    double eye[3], target[3];
+    memcpy(eye, A64_PTR(view + 96), sizeof eye);
+    memcpy(target, A64_PTR(view + 120), sizeof target);
+    if (!hos_coop_view_filter(eye, target)) return 0;
+    const double x = eye[0] - target[0], y = eye[1] - target[1], z = eye[2] - target[2];
+    if (!(hypot(x, z) > 1e-6) || !isfinite(x + y + z)) return 0;   /* (straight down, or not a number: the game's own) */
+    const double yaw = atan2(x, z), pitch = atan2(y, hypot(x, z));
+    const double sy = sin(yaw), cy = cos(yaw), sp = sin(pitch), cp = cos(pitch);
+    const double axes[3][3] = {{cy, 0, -sy}, {-sp * sy, cp, -sp * cy}, {cp * sy, sp, cp * cy}};
+    for (int row = 0; row < 3; row++) {
+        const double *axis = axes[row];
+        const float values[4] = {(float)axis[0], (float)axis[1], (float)axis[2],
+            (float)-(axis[0] * eye[0] + axis[1] * eye[1] + axis[2] * eye[2])};
+        for (int col = 0; col < 4; col++) {
+            uint32_t bits;
+            memcpy(&bits, &values[col], sizeof bits);
+            recomp_store32(c, view + 8 + (row * 4 + col) * 4, bits);
+        }
+    }
+    return 1;
+}
 #endif
 
 void hos_oot_free_view(Ctx *c, uint64_t view) {
@@ -1628,6 +1655,7 @@ void hos_oot_free_view(Ctx *c, uint64_t view) {
 
     // Camera zero supplies the gameplay view. The same matrix routine also serves other cameras.
     if (oot_gameplay_view(c) != view) return;
+    if (oot_coop_view(c, view)) return;   /* (oot-remake-multiplayer, patch 0019: the co-op module's camera first) */
 
     static SRWLOCK lock = SRWLOCK_INIT;
     AcquireSRWLockExclusive(&lock);
