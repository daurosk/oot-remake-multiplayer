+        cp &= more == 3 ? 0x07 : more == 2 ? 0x0F : more == 1 ? 0x1F : 0x7F;
+        for (; more > 0 && (*t & 0xC0) == 0x80; more--) cp = cp << 6 | (*t++ & 0x3F);
+        hos_coop_char(more ? 0xFFFD : cp);
+    }
+}
