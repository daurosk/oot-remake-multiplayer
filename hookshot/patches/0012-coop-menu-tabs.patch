+/// (oot-remake-multiplayer) A co-op module's tab under the banner (hos_coop_menu.h): its rows in the column with the menu's
+/// own cells (an action's value cell, or the page arrow when it has none; a choice with its arrows; a toggle's Off and On
+/// halves; a heading as Hookshot's; a note as one line of text), the help box beside it and the prompts the module names.
+/// The hits are the module's row numbers, as Hookshot's own rows: coop_tick hands the cursor and the clicks on
+void draw_coop_page(ui::Ctx& c, float hh) {
+    const float s = c.s;
+    float cx0, cx1, hx0, hx1;
+    bool narrow;
+    columns(c, &cx0, &cx1, &hx0, &hx1, &narrow);
+    column(c, cx0, cx1, hh);
+    HosCoopMenuPage p{};
+    if (!coop::menu_page(coop_tab, &p)) p = HosCoopMenuPage{}, p.selected = -1;
+    auto said = [](const char* t) { return t && *t ? t : nullptr; };
+    ui::Prompt prompt_list[6];
+    int prompts_n = 0;
+    if (!p.typing) prompt_list[prompts_n++] = {ui::kUpDown, "Choose"};
+    if (said(p.change)) prompt_list[prompts_n++] = {ui::kLeftRight, p.change};
+    if (said(p.confirm)) prompt_list[prompts_n++] = {ui::kConfirm, p.confirm};
+    if (!p.typing) prompt_list[prompts_n++] = {ui::kTabs, "Tabs"};
+    prompt_list[prompts_n++] = {ui::kBack, said(p.back) ? p.back : "Close"};
+    const float bar_top = ui::prompt_bar_top(c);
+    float bottom = std::min(c.h - c.safe, bar_top) - 10 * s;
+    if (narrow) {   // (as draw_options: the help over the column's foot, at most half the room)
+        const float help_h = (bottom - hh) * 0.5f;
+        bottom = std::min(bar_top, c.h - c.safe) - help_h - 16 * s;
+        help_box(c, hx0, hx1, bottom + 8 * s, said(p.help_title), said(p.help), said(p.hint), said(p.gold), 0, false,
+                 bottom + 8 * s, bar_top - 10 * s);
+    } else {
+        help_box(c, hx0, hx1, std::max(hh + 26 * s, c.h * 0.30f), said(p.help_title), said(p.help), said(p.hint), said(p.gold),
+                 0, false, hh + 18 * s, bar_top - 12 * s);
+    }
+    const float rh = 40 * s, pitch = 48 * s, top = hh + 24 * s, rx0 = cx0 + 44 * s, rx1 = cx1 - 44 * s,
+                split = rx0 + (rx1 - rx0) * 0.55f;
+    int shown = 0;
+    const float first = scroll_rows(kCoopSlot, p.rows_n, std::max(0, p.selected), top, bottom, pitch, &shown);
+    scroll_bar(c, cx0 + 20 * s, top, top + shown * pitch - (pitch - rh), p.rows_n, shown, first);
+    marquee_max = 0;
+    c.d->PushClipRect(ImVec2(cx0, top - 8 * s), ImVec2(cx1, bottom + 8 * s));
+    for (int i = 0; i < p.rows_n; i++) {
+        const float y = top + (i - first) * pitch;
+        if (y + rh < top - 8 * s || y > bottom + 8 * s) continue;
+        const HosCoopMenuRow& r = p.rows[i];
+        const char* name = r.name ? r.name : "";
+        if (r.kind == HOS_COOP_MENU_HEADING) {   // (as a Hookshot heading: gold, a rule after it)
+            const float ty = y + rh * 0.62f, tw = ui::size_of(c.f.heading, 19 * s, name).x;
+            ui::text_mid(c, c.f.heading, 19 * s, rx0 + 2 * s, ty, ui::kGoldHi, name);
+            c.d->AddLine(ImVec2(rx0 + tw + 16 * s, ty), ImVec2(rx1, ty), ui::alpha(ui::kEdge, 0.9f), std::max(1.0f, s));
+            continue;
+        }
+        if (r.kind == HOS_COOP_MENU_NOTE) {   // (a line of text, nothing to click)
+            const std::string line = fit(c, c.f.body, 18 * s, rx1 - rx0 - 4 * s, name, false);
+            ui::text_mid(c, c.f.body, 18 * s, rx0 + 2 * s, y + rh * 0.5f, ui::kSoft, line.c_str());
+            continue;
+        }
+        const bool selected = i == p.selected, fixed = r.fixed != 0;
+        name_cell(c, ImVec2(rx0, y), ImVec2(split, y + rh), name, selected);
+        const ImVec2 va(split, y), vb(rx1, y + rh);
+        const std::string value = r.value ? r.value : "";
+        if (r.kind == HOS_COOP_MENU_TOGGLE) {
+            halves_cell(c, va, vb, "Off", "On", r.on != 0, selected, fixed);
+        } else if (r.kind == HOS_COOP_MENU_CHOICE) {
+            choice_cell(c, va, vb, value, selected, r.left && !fixed, r.right && !fixed, fixed);
+        } else if (value.empty()) {   // (an action with no value: it opens a page, as Hookshot's own page rows)
+            choice_cell(c, va, vb, "", selected, false, false, fixed);
+            ui::triangle(c, ImVec2(vb.x - 15 * s, (va.y + vb.y) * 0.5f), 10 * s, 1, selected && !fixed ? ui::kGoldInk : ui::kInk);
+        } else {
+            choice_cell(c, va, vb, value, selected, false, false, fixed);
+        }
+        hits.add(rx0, std::max(y, top - 8 * s), rx1, std::min(y + rh, bottom + 8 * s), menu_hit::kRow, i, va.x, vb.x, 0, 0);
+    }
+    c.d->PopClipRect();
+    ui::prompt_bar(c, prompt_list, prompts_n);
+}
+
 void draw_options(ui::Ctx& c) {
     const float s = c.s, hh = banner_h(c);
     ui::banner(c, hh);
     // the tabs in the banner: dark ink on the tan, the shown one light on a dark inset; the tab keys at their ends (a click there
