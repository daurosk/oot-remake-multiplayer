@@ -472,6 +473,8 @@ static LRESULT CALLBACK wndproc(HWND w, UINT msg, WPARAM wp, LPARAM lp) {
             if (fullscreen) set_fullscreen(w,1); /* selection/hotplug changes, on the window thread */
         }
