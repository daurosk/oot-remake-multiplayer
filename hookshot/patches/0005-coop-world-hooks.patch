diff --git a/host/coop_platform_ring.c b/host/coop_platform_ring.c
deleted file mode 100644
index b241703..0000000
--- a/host/coop_platform_ring.c
+++ /dev/null
@@ -1,19 +0,0 @@
-/* (oot-remake-multiplayer's patch 0003, nx2/coop_platform_lift.py) A started AI pause counter goes into co-op's ring.
-
-   The same ring the emulator's cave fills (lichii/hook/coop_counter.s): its address is the u64 at main+0x3c46780,
-   0 until the co-op module made it with the game's malloc (lichii/hook/coop_counters.h). Ring: +0 a u32 count, +8 256
-   u64 nodes; the node goes at (count + 1) % 256 and the count goes up. The module reads it a few times a second and
-   checks every node itself (vtable, actor), so a lost or doubled entry costs nothing; no lock, as on the emulator. */
-#include "hos.h"
-
-enum { COOP_RING_NODES = 256 };
-#define COOP_MAIN 0x80020000ull
-#define COOP_RING_POINTER (COOP_MAIN + 0x3c46780ull)
-
-void hos_coop_counter(uint64_t node) {
-    const uint64_t ring = G64(COOP_RING_POINTER);
-    if (!ring || !node) return;
-    const uint32_t n = G32(ring) + 1;
-    G32(ring) = n;
-    *(uint64_t *)GP(ring + 8 + 8ull * (n % COOP_RING_NODES)) = node;
-}
diff --git a/host/coop_world.c b/host/coop_world.c
new file mode 100644
index 0000000..fac8b78
--- /dev/null
+++ b/host/coop_world.c
@@ -0,0 +1,59 @@
+/* Co-op (oot-remake-multiplayer, GPL-3.0; its docs/hookshot.md "World hooks", patch 0005): the game's world events
+   straight to the co-op module, through the game's own functions.
+
+   Two kinds of hook, both made when Hookshot is built (nx2/coop_world_wraps.py):
+   - an event after one instruction (Lifter.after): hos_coop_world_event, to the module's hos_coop_world;
+   - a wrapped game function (Lifter.wraps): every call of f_<entry> and the indirect table reach hos_coop_w_<entry>
+     (a64_hooks.c), which calls hos_coop_wrap before (phase 0: 1 = the module did the call's work, the game's function
+     is not run) and after (phase 1) the game's function, to the module's hos_coop_wrap with the registers.
+   The bridge (coop_bridge.c) loads the module at the first frame hook; until then, without it, or with a module that has
+   no such export, a hook costs a load and a counter. The exports are kept only once the module says it is on
+   (HOS_COOP_WORLD_HELLO answers 1): a module the bridge refused and unloads never answers 1, and one that is on stays
+   loaded until exit. */
+#if !defined(_WIN32) && !defined(_GNU_SOURCE)
+#define _GNU_SOURCE   /* (RTLD_DEFAULT) */
+#endif
+#include "hos.h"
+#include "hos_coop_world.h"
+#include <stddef.h>
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#else
+#include <dlfcn.h>
+#endif
+
+static hos_coop_world_fn world;   /* (atomic) the module's exports, once it said it is on */
+static hos_coop_wrap_fn wrap;
+static int found;                 /* (atomic) 1 once both were looked up with the module on */
+static uint32_t wait;             /* (atomic) hooks until the next look */
+
+static int find(void) {
+    if (__atomic_load_n(&found, __ATOMIC_ACQUIRE)) return 1;
+    if (__atomic_fetch_add(&wait, 1, __ATOMIC_RELAXED) % 256 != 0) return 0;   /* (a look per 256 hooks) */
+#ifdef _WIN32
+    HMODULE m = GetModuleHandleA("hookshot_coop.dll");
+    if (!m) return 0;
+    hos_coop_world_fn w = (hos_coop_world_fn)(void *)GetProcAddress(m, "hos_coop_world");
+    hos_coop_wrap_fn p = (hos_coop_wrap_fn)(void *)GetProcAddress(m, "hos_coop_wrap");
+#else
+    void *m = dlopen("hookshot_coop.so", RTLD_NOW | RTLD_NOLOAD);
+    hos_coop_world_fn w = (hos_coop_world_fn)(m ? dlsym(m, "hos_coop_world") : dlsym(RTLD_DEFAULT, "hos_coop_world"));
+    hos_coop_wrap_fn p = (hos_coop_wrap_fn)(m ? dlsym(m, "hos_coop_wrap") : dlsym(RTLD_DEFAULT, "hos_coop_wrap"));
+#endif
+    if (!w || w(HOS_COOP_WORLD_HELLO, 0, 0) != 1) return 0;
+    __atomic_store_n(&wrap, p, __ATOMIC_RELAXED);   /* (may stay NULL: a module with events and no wraps) */
+    __atomic_store_n(&world, w, __ATOMIC_RELAXED);
+    __atomic_store_n(&found, 1, __ATOMIC_RELEASE);
+    return 1;
+}
+
+void hos_coop_world_event(uint32_t event, uint64_t a, uint64_t b) {
+    if (find()) __atomic_load_n(&world, __ATOMIC_RELAXED)(event, a, b);
+}
+
+int hos_coop_wrap(uint32_t id, int phase, Ctx *A64_NOESC c) {
+    if (!find()) return 0;
+    hos_coop_wrap_fn p = __atomic_load_n(&wrap, __ATOMIC_RELAXED);
+    return p ? p(id, phase, c->x, c) : 0;
+}
diff --git a/host/hos_coop_world.h b/host/hos_coop_world.h
new file mode 100644
index 0000000..a2ec7d4
--- /dev/null
+++ b/host/hos_coop_world.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Co-op's world hooks on Hookshot (oot-remake-multiplayer, docs/hookshot.md "World hooks"; our patch 0005).
+
+   On the emulator co-op learns what the game does in its world through code caves patched into the game (the pause
+   counters' cave, lichii/hook/coop_counter.s, fills a ring in the game's heap). On Hookshot the game is C: a lift-time
+   hook at the game function calls hos_coop_world_event (Hookshot's host/coop_world.c), which hands the event to the
+   module's optional export hos_coop_world. No guest memory, no cave, no game call.
+
+   The same file is in Hookshot's host/ through our patch 0005 and in our repository (hookshot/src): keep them equal
+   (tests/hookshot/module_test.cpp checks it). Plain C. */
+#ifndef HOS_COOP_WORLD_H
+#define HOS_COOP_WORLD_H
+#include <stdint.h>
+
+/* Events. a and b as listed; a new event takes the next number, an old module answers 0 to one it does not know. */
+#define HOS_COOP_WORLD_HELLO 0u           /* asked by Hookshot before it keeps the export: 1 once the module is on */
+#define HOS_COOP_WORLD_COUNTER_START 1u   /* main+0x5e6760 started an AI ExecuteGenericCounter: a = the node */
+
+/* Wrapped game functions (nx2/coop_world_wraps.py WRAPS: id, main offset, first words). A new wrap takes the next id. */
+#define HOS_COOP_WRAP_FLAG_APPLY 1u   /* main+0xb99980: the game applies its queued flag writes (the save load's too) */
+
+/* The module's exports (extern "C"), both optional. Called on the game thread that ran the hooked function (not always
+   the calc thread): quick, no lock the game waits on, no game call. hos_coop_world returns 1 when taken.
+   hos_coop_wrap: phase 0 before the game's function, phase 1 after it; x = the guest registers x0-x31 (x[31] is SP),
+   read and written in place (arguments at phase 0, x0 the result at phase 1); ctx = the game's context (for later
+   use with HosCoopApi::call, not yet allowed here). Phase 0 returning 1 means the module did the call's work and the
+   game's function is not run (phase 1 still comes); return 0 to let the game run it, as nearly always. */
+typedef int (*hos_coop_world_fn)(uint32_t event, uint64_t a, uint64_t b);
+typedef int (*hos_coop_wrap_fn)(uint32_t id, int phase, uint64_t *x, void *ctx);
+
+#endif
