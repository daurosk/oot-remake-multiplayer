 }
+
+/* ---- (oot-remake-multiplayer, patch 0009) co-op voice chat's stream (host/coop_voice.c, hos_coop_voice.h) ----
+   A stream of its own, not the game's (no handle of the game's names it), on the source the game's streams of the same
+   format use: the one microphone, the Insert menu's choice, silence when that is off. Or, once the co-op settings chose a
+   microphone for the voice (hos_voice_mic_choose), on a source of its own that follows that one by its name, opened again
+   once it is back as the menu's are; while it is not plugged in: silence (no stand-in: only the one chosen opens). 48 kHz mono 16-bit, a quarter second held (older is
+   dropped while nobody reads). Started and read from the module's one thread. */
+static int voice_at = -1;   /* (under lock) its place in streams, -1: none */
+static void voice_attach(InStream *s) {   /* (under lock) onto its own source while a microphone is named, else the game's */
+    AcquireSRWLockShared(&list_lock);
+    const int named = voice_name[0] != 0;
+    ReleaseSRWLockShared(&list_lock);
+    int i = 0;
+    while (named && i < MAX_STREAMS + 1 && sources[i].used) i++;   /* (any free source: the streams' and the microphone test's) */
+    if (!named || i == MAX_STREAMS + 1) {
+        attach(s);
+        return;
+    }
+    Source *src = &sources[i];
+    memset(src, 0, sizeof *src);
+    src->used = 1, src->users = 1, src->own = 1, src->silence_from_ns = hos_now_ns(), src->retry_wait = RETRY_NS;
+    src->format = s->format, src->channels = s->channels, src->rate = s->rate, src->frame_bytes = s->frame_bytes;
+    s->source = i;
+    choose(src);
+}
+int hos_voice_mic_start(void) {
+    AcquireSRWLockExclusive(&lock);
+    int i = voice_at;
+    if (i < 0) {
+        i = 0;
+        while (i < MAX_STREAMS && streams[i].used) i++;
+        if (i < MAX_STREAMS) {
+            InStream *s = &streams[i];
+            memset(s, 0, sizeof *s);
+            s->format = FMT_PCM16, s->channels = 1, s->rate = 48000, s->frame_bytes = 2, s->capacity = 48000 / 4;
+            s->ring = (uint8_t *)malloc((size_t)s->capacity * s->frame_bytes);
+            if (s->ring) {
+                s->used = 1, s->started = 1, s->source = -1;
+                voice_attach(s);
+                voice_at = i;
+            } else {
+                memset(s, 0, sizeof *s);
+                i = -1;
+            }
+        } else {
+            i = -1;
+        }
+    }
+    ReleaseSRWLockExclusive(&lock);
+    hos_log(i >= 0 ? "audio in: co-op voice stream %d started" : "audio in: co-op voice stream not started (%d)", i);
+    return i >= 0;
+}
+int hos_voice_mic_read(int16_t *out, int max) {
+    AcquireSRWLockExclusive(&lock);
+    int frames = 0;
+    if (voice_at >= 0 && out && max > 0) {
+        InStream *s = &streams[voice_at];
+        const int have = filled(s);
+        frames = max < have ? max : have;
+        const int cap = s->capacity * s->frame_bytes, n = frames * s->frame_bytes;
+        const int first = n < cap - s->ring_start ? n : cap - s->ring_start;
+        memcpy(out, s->ring + s->ring_start, (size_t)first);
+        memcpy((uint8_t *)out + first, s->ring, (size_t)(n - first));
+        s->ring_start = (s->ring_start + n) % cap, s->ring_len -= n;
+    }
+    ReleaseSRWLockExclusive(&lock);
+    return frames;
+}
+void hos_voice_mic_stop(void) {
+    AcquireSRWLockExclusive(&lock);
+    if (voice_at >= 0) {
+        InStream *s = &streams[voice_at];
+        s->started = 0;
+        detach(s);
+        free(s->ring);
+        memset(s, 0, sizeof *s);
+        voice_at = -1;
+    }
+    ReleaseSRWLockExclusive(&lock);
+}
+/* The microphones there are now (none opened), for the co-op settings' Microphone row: up to max names of name_size bytes. */
+int hos_voice_mic_list(char *names, int name_size, int max) {
+    uint32_t ids[MAX_DEVICES];
+    char found[MAX_DEVICES][128];
+    const int n = names && name_size > 0 && max > 0 ? hos_sdl_mic_list(ids, found, MAX_DEVICES) : 0;
+    int k = 0;
+    for (; k < n && k < max; k++) snprintf(names + (size_t)k * (size_t)name_size, (size_t)name_size, "%s", found[k]);
+    return k;
+}
+/* The voice's microphone by its name, "" or NULL: the game's again. Opens nothing: a started stream moves to it at once (a
+   source of its own, or back on the game's), a stopped one when it starts. */
+void hos_voice_mic_choose(const char *name) {
+    /* (both under lock, which every read holds: no read sees the new name before the stream is on its new source) */
+    AcquireSRWLockExclusive(&lock);
+    AcquireSRWLockExclusive(&list_lock);
+    const int was = voice_name[0] != 0;
+    snprintf(voice_name, sizeof voice_name, "%s", name ? name : "");
+    const int named = voice_name[0] != 0;
+    voice_gen++;
+    ReleaseSRWLockExclusive(&list_lock);
+    if (was != named && voice_at >= 0) {   /* (another name on its own source: choose() opens that one at the next read) */
+        InStream *s = &streams[voice_at];
+        detach(s);
+        voice_attach(s);
+    }
+    ReleaseSRWLockExclusive(&lock);
+    hos_log("coop voice: microphone: %s", named ? name : "the game's (the Insert menu's)");
+}
