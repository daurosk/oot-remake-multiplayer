+/* (oot-remake-multiplayer's patch 0010, local co-op) The pads one by one, for nn_hid.c and the co-op module (whose
+   exports are in nn_hid.c). hos_sdl_pad_slot: slot's pad (1 when one is open there, 0 none, -1 past the last slot): its serial (which opening; 0 for
+   none), its name, its own buttons (1 << HOS_PAD_*) and sticks, and the Npad a local player took it as (0: none, 1 to
+   3: No.2 to No.4). hos_sdl_pad_take: npad 1 to 3 gives the pad of that serial to that Npad (one pad per Npad: another
+   pad that had it is given back), 0 gives it back to the merged state; 1 when done. */
+int hos_sdl_pad_slot(int slot, uint32_t *serial, char *name, size_t cap, uint64_t *raw, int32_t stick[4], int *npad) {
+    if (slot < 0 || slot >= MAX_PADS) return -1;
+    AcquireSRWLockShared(&state_lock);
+    const int open = slot_serial[slot] != 0;
+    if (serial) *serial = slot_serial[slot];
+    if (name && cap) snprintf(name, cap, "%s", slot_name[slot]);
+    if (raw) *raw = open ? slot_raw[slot] : 0;
+    if (stick) memcpy(stick, open ? slot_stick[slot] : (const int32_t[4]){0}, 4 * sizeof *stick);
+    if (npad) *npad = open && taken_serial[slot] == slot_serial[slot] ? taken_npad[slot] : 0;
+    ReleaseSRWLockShared(&state_lock);
+    return open;
+}
+int hos_sdl_pad_take(int slot, uint32_t serial, int npad) {
+    if (slot < 0 || slot >= MAX_PADS || npad < 0 || npad > 3) return 0;
+    AcquireSRWLockExclusive(&state_lock);
+    const int ok = serial && slot_serial[slot] == serial;
+    if (ok) {
+        for (int i = 0; npad && i < MAX_PADS; i++)
+            if (taken_npad[i] == npad) taken_npad[i] = 0;
+        taken_npad[slot] = npad;
+        taken_serial[slot] = serial;
+    }
+    ReleaseSRWLockExclusive(&state_lock);
+    if (ok) hos_log("hid: controller %d %s", slot, npad ? "taken by a local player" : "given back to player 1");
+    return ok;
+}
+/* The pad that is that Npad (1 to 3: No.2 to No.4), its own buttons and sticks; 0 when no pad is */
+int hos_sdl_pad_npad(int npad, uint64_t *raw, int32_t stick[4]) {
+    int found = 0;
+    AcquireSRWLockShared(&state_lock);
+    for (int i = 0; npad && i < MAX_PADS && !found; i++)
+        if (taken_npad[i] == npad && slot_serial[i] && taken_serial[i] == slot_serial[i]) {
+            *raw = slot_raw[i];
+            memcpy(stick, slot_stick[i], 4 * sizeof *stick);
+            found = 1;
+        }
+    ReleaseSRWLockShared(&state_lock);
+    return found;
+}
