From d370424eca4d5ac4dcc2075e7f5c6aa60b8c4436 Mon Sep 17 00:00:00 2001
From: coop-fetch <coop-fetch@localhost>
Date: Fri, 13 Nov 2026 00:35:10 -0900
Subject: [PATCH] Co-op mods: the Mods tab's order and switches, read at the
 start

oot-remake-multiplayer's patch 0011 (docs/mods.md). The co-op module's Mods
tab cannot move or rename a mod while the game has its files open, and the
mods are indexed before the module is loaded. host/mods.c now reads
<mods>/coop-mods.list (written by the tab: the order, and the mods turned
off) before it sorts and indexes the mods, and writes what this run indexed
into <mods>/coop-mods.applied, from which the tab says whether a restart is
needed. host/hos_coop_mods.h (plain C, header only) is the two files' format,
the same file as the module's. Without a list file nothing changes. Host
code only: no lift change.
---
 host/hos_coop_mods.h | 109 +++++++++++++++++++++++++++++++++++++++++++
 host/mods.c          |  57 +++++++++++++++++++++-
 2 files changed, 164 insertions(+), 2 deletions(-)
 create mode 100644 host/hos_coop_mods.h

diff --git a/host/hos_coop_mods.h b/host/hos_coop_mods.h
new file mode 100644
index 0000000..c766346
--- /dev/null
+++ b/host/hos_coop_mods.h
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   The mods list between the co-op module's Mods tab and Hookshot's mod loader (oot-remake-multiplayer, docs/mods.md).
+
+   Hookshot indexes its mods folder once, at the start, before the module is loaded, and keeps the game's files open
+   while it runs. So the tab never renames or moves a mod: it writes one small file into the mods folder, and Hookshot's
+   host/mods.c (our patch 0011) reads it at the next start:
+
+     <mods>/coop-mods.list      written by the module: the order and the switches
+         coop-mods 1
+         on <name>              first row = wins a file two mods have (it is indexed last)
+         off <name>             left out
+       <name> is the mod's name as Hookshot logs it: its path under the mods folder with '/'. A mod the list does not
+       name is on and keeps Hookshot's own order (by name) under the named ones. Lines it does not know are skipped.
+
+     <mods>/coop-mods.applied   written by Hookshot at each start: what this run indexed
+         coop-mods-applied 1 <process id>
+         on <files> <name>      in the order indexed (the last one wins)
+         off <name>
+
+   The same file is in Hookshot's host/ through our patch and in our repository (hookshot/src): keep them equal
+   (tests/hookshot/mods_test.cpp checks it). Plain C, header only, no Hookshot or co-op include. */
+#ifndef HOS_COOP_MODS_H
+#define HOS_COOP_MODS_H
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+
+#define HOS_COOP_MODS_VERSION 1
+#define HOS_COOP_MODS_LIST_FILE "coop-mods.list"
+#define HOS_COOP_MODS_APPLIED_FILE "coop-mods.applied"
+#define HOS_COOP_MODS_MAX 256    /* rows read; more are skipped */
+#define HOS_COOP_MODS_NAME 260   /* a name with its 0 (MAX_PATH) */
+/* The most a list file can hold that is read: a caller's buffer for it. */
+#define HOS_COOP_MODS_TEXT_MAX (HOS_COOP_MODS_MAX * (HOS_COOP_MODS_NAME + 8) + 64)
+
+typedef struct HosCoopModsRow {
+    char name[HOS_COOP_MODS_NAME];
+    int off;
+} HosCoopModsRow;
+
+typedef struct HosCoopModsList {
+    int count;
+    HosCoopModsRow rows[HOS_COOP_MODS_MAX];
+} HosCoopModsList;
+
+/* Names are compared as Hookshot sorts them: ASCII letters without case; '\' counts as '/'. */
+static inline int hos_coop_mods_fold(int c) {
+    if (c == '\\') return '/';
+    return c >= 'A' && c <= 'Z' ? c - 'A' + 'a' : c;
+}
+static inline int hos_coop_mods_same(const char *a, const char *b) {
+    for (;; a++, b++) {
+        if (hos_coop_mods_fold((unsigned char)*a) != hos_coop_mods_fold((unsigned char)*b)) return 0;
+        if (!*a) return 1;
+    }
+}
+
+/* Reads a list file's text (n bytes; no 0 needed). 1 when it is a list of this version; else 0 and an empty list. */
+static inline int hos_coop_mods_parse(const char *text, size_t n, HosCoopModsList *out) {
+    size_t at = 0;
+    int line_no = 0;
+    out->count = 0;
+    while (at < n) {
+        size_t end = at, len;
+        const char *line = text + at;
+        while (end < n && text[end] != '\n') end++;
+        len = end - at;
+        at = end + 1;
+        if (len && line[len - 1] == '\r') len--;
+        if (line_no++ == 0) {
+            if (len != 11 || memcmp(line, "coop-mods 1", 11)) return 0;
+            continue;
+        }
+        {
+            int off;
+            int i, known = 0;
+            if (len > 3 && !memcmp(line, "on ", 3)) off = 0, line += 3, len -= 3;
+            else if (len > 4 && !memcmp(line, "off ", 4)) off = 1, line += 4, len -= 4;
+            else continue;
+            if (len >= HOS_COOP_MODS_NAME || out->count >= HOS_COOP_MODS_MAX) continue;
+            memcpy(out->rows[out->count].name, line, len);
+            out->rows[out->count].name[len] = 0;
+            for (i = 0; i < out->count && !known; i++)   /* (a name twice: its first row counts) */
+                known = hos_coop_mods_same(out->rows[i].name, out->rows[out->count].name);
+            if (known) continue;
+            out->rows[out->count++].off = off;
+        }
+    }
+    return line_no > 0;
+}
+
+/* A mod's place: -1 = off; 0 = not in the list (Hookshot's own order, under the listed ones); else the higher wins
+   (the list's first row has the highest). Mods are indexed by rising rank, then by name. */
+static inline int hos_coop_mods_rank(const HosCoopModsList *list, const char *name) {
+    int i;
+    for (i = 0; i < list->count; i++)
+        if (hos_coop_mods_same(list->rows[i].name, name)) return list->rows[i].off ? -1 : list->count - i;
+    return 0;
+}
+
+/* The applied file's lines (each with its '\n'); what snprintf returns. */
+static inline int hos_coop_mods_applied_head(char *out, size_t cap, unsigned long pid) {
+    return snprintf(out, cap, "coop-mods-applied %d %lu\n", HOS_COOP_MODS_VERSION, pid);
+}
+static inline int hos_coop_mods_applied_row(char *out, size_t cap, const char *name, int files) {   /* files < 0: off */
+    return files < 0 ? snprintf(out, cap, "off %s\n", name) : snprintf(out, cap, "on %d %s\n", files, name);
+}
+
+#endif
diff --git a/host/mods.c b/host/mods.c
index 720aa32..a349274 100644
--- a/host/mods.c
+++ b/host/mods.c
@@ -111,7 +111,7 @@ static int index_romfs(const char *host_dir, const char *rel, int depth) {
 }
 
 /* the mod folders under root, sorted (a mod: a folder holding romfs or exefs) */
-typedef struct { char path[MAX_PATH]; char name[MAX_PATH]; } Mod;
+typedef struct { char path[MAX_PATH]; char name[MAX_PATH]; int rank, files; } Mod;   /* (co-op) rank, files: coop_mods_rank */
 static Mod *mods;
 static int nmods, cap_mods;
 static void find_mods(const char *dir, const char *name, int depth) {
@@ -146,7 +146,52 @@ static void find_mods(const char *dir, const char *name, int depth) {
     } while (FindNextFileA(f, &fd));
     FindClose(f);
 }
-static int mod_cmp(const void *a, const void *b) { return _stricmp(((const Mod *)a)->name, ((const Mod *)b)->name); }
+static int mod_cmp(const void *a, const void *b) {
+    const Mod *x = (const Mod *)a, *y = (const Mod *)b;
+    if (x->rank != y->rank) return x->rank < y->rank ? -1 : 1;   /* (co-op) the Mods tab's order; all 0 without its list */
+    return _stricmp(x->name, y->name);
+}
+
+/* (oot-remake-multiplayer, patch 0011, docs/mods.md) The co-op module's Mods tab cannot move or rename a mod while the
+   game has its files open, and the mods are indexed before the module is loaded. So the tab writes its order and
+   switches into <mods>\coop-mods.list, read here at the start, and this run's result goes into
+   <mods>\coop-mods.applied, from which the tab knows what the running game uses (and whether a restart is needed).
+   Without the list file nothing changes. The two files' lines: hos_coop_mods.h. */
+#include "hos_coop_mods.h"
+static HosCoopModsList coop_list;
+static void coop_mods_rank(const char *root) {   /* each mod's rank from the tab's list (-1: off) */
+    static char text[HOS_COOP_MODS_TEXT_MAX];
+    char path[MAX_PATH];
+    DWORD n = 0;
+    snprintf(path, sizeof path, "%s\\%s", root, HOS_COOP_MODS_LIST_FILE);
+    HANDLE f = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (f != INVALID_HANDLE_VALUE) {
+        if (!ReadFile(f, text, sizeof text, &n, NULL)) n = 0;
+        CloseHandle(f);
+        if (hos_coop_mods_parse(text, n, &coop_list))
+            hos_log("mods: %s: %d rows (the Mods tab's order and switches)", path, coop_list.count);
+        else
+            hos_log("mods: %s is not a mods list: left out", path);
+    }
+    for (int i = 0; i < nmods; i++) {
+        mods[i].rank = hos_coop_mods_rank(&coop_list, mods[i].name);
+        mods[i].files = -1;
+    }
+}
+static void coop_mods_applied(const char *root) {   /* what this run indexed, for the tab */
+    char path[MAX_PATH], line[MAX_PATH + 32];
+    DWORD done;
+    snprintf(path, sizeof path, "%s\\%s", root, HOS_COOP_MODS_APPLIED_FILE);
+    HANDLE f = CreateFileA(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (f == INVALID_HANDLE_VALUE) return;
+    int n = hos_coop_mods_applied_head(line, sizeof line, (unsigned long)GetCurrentProcessId());
+    WriteFile(f, line, (DWORD)n, &done, NULL);
+    for (int i = 0; i < nmods; i++) {
+        n = hos_coop_mods_applied_row(line, sizeof line, mods[i].name, mods[i].rank < 0 ? -1 : mods[i].files);
+        WriteFile(f, line, (DWORD)n, &done, NULL);
+    }
+    CloseHandle(f);
+}
 
 /* hos_main.c, once the image is loaded (image_path: kept for exefs patches, which are not applied here) */
 void hos_mods_init(const char *image_path) {
@@ -162,21 +207,29 @@ void hos_mods_init(const char *image_path) {
     }
     if (GetFileAttributesA(root) == INVALID_FILE_ATTRIBUTES) return;
     find_mods(root, "", 0);
+    coop_mods_rank(root);   /* (co-op) */
     if (!nmods) {
         hos_log("mods: none in %s (a mod: <name>\\romfs)", root);
+        coop_mods_applied(root);   /* (co-op) */
         return;
     }
     qsort(mods, (size_t)nmods, sizeof *mods, mod_cmp);
     for (int i = 0; i < nmods; i++) {
+        if (mods[i].rank < 0) {   /* (co-op) */
+            hos_log("mods: %s is off (the Mods tab)", mods[i].name);
+            continue;
+        }
         char dir[MAX_PATH];
         snprintf(dir, sizeof dir, "%s\\romfs", mods[i].path);
         const int files = index_romfs(dir, "", 0);
+        mods[i].files = files;   /* (co-op) */
         snprintf(dir, sizeof dir, "%s\\exefs", mods[i].path);
         if (GetFileAttributesA(dir) != INVALID_FILE_ATTRIBUTES)
             hos_log("mods: %s: exefs patches are left out (the code is compiled ahead of time)", mods[i].name);
         hos_log("mods: %s: %d RomFS files", mods[i].name, files);
     }
     hos_log("mods: %d mods from %s: %zu RomFS entries", nmods, root, table_n);
+    coop_mods_applied(root);   /* (co-op) */
 }
 
 /* nn_fs.c: the mod file for a RomFS path ("UI/x.zs", no mount, no leading slash), or 0 */
-- 
