From 47071154b380820ebbd22a6083c4f45bbca5d376 Mon Sep 17 00:00:00 2001
From: daurosk <354202035+daurosk@users.noreply.github.com>
Date: Fri, 13 Nov 2026 20:38:47 -0900
Subject: [PATCH] Co-op texture overrides in the WebGPU renderer

gpu/render/rx_texture.cpp: the WebGPU renderer reads a texture's storage
through hos_coop_texture_overlay (patch 0020: host/coop_texture.c) in
decode, as the Vulkan one does in guest_bytes. Its own patch because
only the Windows source has the WebGPU renderer (RX_BACKEND=webgpu, the
fallback when longshot_vk.dll does not load); Longshot's Linux builder
carries gpu/render's headers only and builds the Vulkan renderer, so the
Linux kit leaves this patch out (tools/release/make_kit_linux.sh).
---
 gpu/render/rx_texture.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/gpu/render/rx_texture.cpp b/gpu/render/rx_texture.cpp
index c7d424a9..0322af4f 100644
--- a/gpu/render/rx_texture.cpp
+++ b/gpu/render/rx_texture.cpp
@@ -341,6 +341,8 @@ std::unordered_map<uint64_t, WGPUSampler> samplers;
 } // namespace
 
 namespace { uint64_t sample_hash(uint64_t va, uint64_t size); }
+extern "C" int hos_coop_texture_overridden(uint64_t address, uint64_t n);            // (patch 0020: host/coop_texture.c)
+extern "C" int hos_coop_texture_overlay(uint64_t address, uint8_t* data, uint64_t n);
 
 // RX_DUMP_TEX=texels: the textures the game last wrote with WriteTexels (rx_nvn.cpp) instead of a list of addresses
 static std::mutex texels_mu;
@@ -638,6 +640,12 @@ std::unique_ptr<Image> decode(const TICEntry& tic, const TexInfo& info_in, uint6
         gpu_read(va, scratch.data(), total);
         src = scratch.data();
     }
+    // (oot-remake-multiplayer, patch 0020: host/hos_coop_texture.h) a co-op module's overrides over the guest's bytes
+    if (va < (1ull << 40) && hos_coop_texture_overridden(va, total)) {
+        if (src != scratch.data()) scratch.assign(src, src + total);
+        hos_coop_texture_overlay(va, scratch.data(), total);
+        src = scratch.data();
+    }
 
     auto im = std::make_unique<Image>();
     im->gpu_va = va;
