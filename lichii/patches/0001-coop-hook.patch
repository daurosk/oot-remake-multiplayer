     // EDEN_NX2_FRAME_CAPTURE=<dir>: every 120th present, save what the renderer shows as
diff --git a/src/yuzu/CMakeLists.txt b/src/yuzu/CMakeLists.txt
index 2475ab500d..e3322ac2fb 100644
--- a/src/yuzu/CMakeLists.txt
+++ b/src/yuzu/CMakeLists.txt
@@ -510,4 +510,8 @@ endif()
 # Remember that the linker is incredibly stupid.
 target_link_libraries(yuzu PRIVATE OpenSSL::SSL OpenSSL::Crypto SDL3::SDL3)
 
+if (LICHII_COOP)
+    include("${LICHII_COOP_DIR}/lichii/hook/qt.cmake")
