index 06771f6e..bd5693c6 100644
--- a/nx2/fastfp.py
+++ b/nx2/fastfp.py
@@ -631,9 +631,10 @@ def emit_function(self, e, texts):
         (k, w) = body[pc]
         kind = k[0]
         # (an instruction joins the run when nothing can enter or leave between it and the next: no label, no patch after  # (fastfp)
-        # it, an op a64emit handled, whose text ff_eligible takes; what it appends below goes to the run instead)  # (fastfp)
+        # it or around it (Lifter.unless, patch 0023), an op a64emit handled, whose text ff_eligible takes; what it appends  # (fastfp)
+        # below goes to the run instead)  # (fastfp)
         joins = False  # (fastfp)
-        if ff and kind == "op" and pc not in self.after and not (pc in labels or (pc == e and e in labels)):  # (fastfp)
+        if ff and kind == "op" and pc not in self.after and pc not in self.unless and not (pc in labels or (pc == e and e in labels)):  # (fastfp)
             t, f = texts[(w, pc) if pc_relative(w) else w]  # (fastfp)
             if not f & (a64emit.UNHANDLED | a64emit.TERMINATOR):  # (fastfp)
                 joins = ff_joins(t, dead.get(pc, 0), stores)  # (fastfp)
@@ -660,7 +661,12 @@ def emit_function(self, e, texts):
                 if pc in dead:
                     text = drop_flag_stores(text, dead[pc])
                     self.stats["dead_flag_stores"] += bin(dead[pc]).count("1")
+                if pc in self.unless:   # (patch 0023)
+                    out.append("if (%s) { %s } else {" % self.unless[pc])
+                    self.stats["unless_emitted"] = self.stats.get("unless_emitted", 0) + 1
                 out.append(text.rstrip("\n"))
+                if pc in self.unless:
+                    out.append("}")
                 if pc in self.after:
                     out.append(self.after[pc])
                     self.stats["after_patches"] = self.stats.get("after_patches", 0) + 1
