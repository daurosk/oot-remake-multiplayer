diff --git a/nx2/coop_world_wraps.py b/nx2/coop_world_wraps.py
new file mode 100644
index 0000000..0d2d632
--- /dev/null
+++ b/nx2/coop_world_wraps.py
@@ -0,0 +1,60 @@
+"""Co-op's wrapped game functions (oot-remake-multiplayer's patch 0005, its docs/hookshot.md "World hooks").
+
+A wrap is the native way for co-op to see and take part in what the game does in its world: every call of the game's
+function (direct, tail and through the indirect table) reaches hos_coop_w_<entry> in a64_hooks.c, which calls the
+co-op module (host/coop_world.c -> hos_coop_wrap) before and after the game's own function. The function's lifted C is
+not changed, so Hookshot's own edits of it (nx2/oot_patches.py) still find it.
+
+WRAPS: (id as in host/hos_coop_world.h, main offset, its first words). Build id and words are checked; a wrap whose
+words differ, an address Hookshot already hooks or patches by name, or another game version leaves it out.
+"""
+import os
+
+MAIN = 0x80020000
+BUILD_ID = "e0f3ccfaf50065ae4ea01eb5aeb13b1a45da3348"
+WRAPS = (
+    # HOS_COOP_WRAP_FLAG_APPLY: the game applies its queued flag writes (the save load's too); the module counts them
+    (1, 0xb99980, (0xd503237f, 0xd10243ff, 0xfd0013e8, 0xa9037bfd)),   # pacibsp; sub sp; str d8; stp x29, x30
+)
+
+
+def _word(img, pc):
+    try:
+        return img.word(pc)
+    except Exception:
+        return None
+
+
+def _patched_by_name():
+    """The functions Hookshot's own C edits find by their head (nx2/oot_patches.py): never wrapped"""
+    try:
+        with open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "oot_patches.py"), encoding="utf-8") as f:
+            return f.read()
+    except OSError:
+        return ""
+
+
+def install(lifter, img, build_id, wraps=WRAPS):
+    """The wraps into lifter.wraps; returns how many went in."""
+    if build_id != BUILD_ID:
+        return 0
+    if not hasattr(lifter, "wraps"):
+        print("co-op wraps: this lifter has no wraps (patch 0005's a64_lift.py): left out")
+        return 0
+    named = _patched_by_name()
+    n = 0
+    for wid, off, words in wraps:
+        pc = MAIN + off
+        bad = next(((pc + 4 * i, w) for i, w in enumerate(words) if _word(img, pc + 4 * i) != w), None)
+        if bad:
+            have = _word(img, bad[0])
+            print("co-op wraps: %d at main+%#x: main+%#x holds %s, not %08x: left out" % (
+                wid, off, bad[0] - MAIN, "?" if have is None else "%08x" % have, bad[1]))
+            continue
+        if pc in lifter.hooks or ("f_%08x(" % pc) in named:
+            print("co-op wraps: %d at main+%#x: Hookshot hooks or edits that function: left out" % (wid, off))
+            continue
+        lifter.wraps[pc] = wid
+        n += 1
+    print("co-op wraps: %d of %d game functions wrapped" % (n, len(wraps)))
+    return n
