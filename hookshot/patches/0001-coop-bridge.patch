@@ -287,6 +294,13 @@ static void read_event(const uint8_t *raw, HosSdlEvent *e) {
             if (dir == 1) e->wheel = -e->wheel;
             break;
         }
+        case 0x303: {   /* (SDL_TextInputEvent: the text's pointer at 24, SDL's until the next poll: copied) */
+            const char *t;
