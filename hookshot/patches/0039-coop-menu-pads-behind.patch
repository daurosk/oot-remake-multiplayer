+/* (oot-remake-multiplayer, patch 0039) a test's presses (HOS_INPUT_SCRIPT, the control bridge) while the Insert menu is
+   open, as the pad inputs bound to them: the menu's, as a controller's are (test_presses_to_menu) */
+static volatile LONG pad_raw_test;
+/* The Insert menu's pads (gpu/vk/vk_menu.cpp): the inputs that are this game's now, whichever window is in front. The
+   pads count as the game's own do (in front; behind other windows with Controller in background on or a pad picked for
+   this game), and pad_raw_now is 0 while they do not (read_input), so the menu needs no focus test of its own: one
+   opened by the co-op module (hos_coop_menu_wanted) with the window behind takes the same pad that opened it */
+uint32_t hos_pad_raw(void) { return (uint32_t)pad_raw_now | (uint32_t)pad_raw_test; }
 
 /* Apply the Insert menu's Stick dead zone to each stick as a pair, for XInput and SDL.
    Keep both components outside the circle so the filter does not snap toward an axis. */
@@ -1440,6 +1447,60 @@ static void keys_behind(uint64_t *buttons, int32_t stick[4]) {
     stick_max(stick, keys);
 }
 
+/* (oot-remake-multiplayer, patch 0039) The player's pads, read: while the Insert menu is open they are its own (hos_pad_raw)
+   and after it closed each input it had waits until it is let go (the press that closed it never reaches the game); the
+   others and the sticks count again at once, so one input that stays down (a worn trigger, a second pad) no longer keeps
+   the rest from the game. The same in front and behind other windows (with Controller in background or a picked pad):
+   behind, the pads used to go to the game with the menu open, which took none of them (patch 0037's Longshot Settings
+   with the window behind: the menu opened and B closed the game's pause under it). Returns the pads' buttons */
+static uint64_t pads_to_game(uint64_t *buttons, int32_t stick[4], int *deck_builtin_input, int front) {
+    uint64_t pb = 0;
+    int32_t ps[4] = {0};
+    pads_read(&pb, ps, deck_builtin_input);
+    static int menu_was;
+    const int menu = rx_option(1, 0);
+    if (menu || menu_was) pad_after_menu |= (uint32_t)pad_raw_now;   /* (the first read after the close too) */
+    else pad_after_menu &= (uint32_t)pad_raw_now;
+    menu_was = menu;
+    if (!menu) {
+        *buttons |= pad_after_menu ? bound_pad_buttons(pad_raw_game & ~pad_after_menu) : pb;
+        stick_max(stick, ps);
+        sprint_now = pad_sprint_down();
+    }
+    if (front && (ps[0] > 12000 || ps[0] < -12000 || ps[1] > 12000 || ps[1] < -12000 || ps[2] > 12000 || ps[2] < -12000 ||
+                  ps[3] > 12000 || ps[3] < -12000))
+        player_used();
+    return pb;
+}
+
+/* (oot-remake-multiplayer, patch 0039) A test's presses (HOS_INPUT_SCRIPT, the control bridge: "anything the player can
+   do with a controller") while the Insert menu is open are the menu's, as a controller's are: given to it as the pad
+   inputs bound to those buttons (hos_pad_raw), and kept from the game, the sticks too; after it closed each one waits
+   until it is let go, as pad_after_menu. They used to reach the game under the open menu */
+static void test_presses_to_menu(uint64_t *buttons, int32_t stick[4]) {
+    static uint64_t test_after_menu;
+    static int menu_was;
+    const int menu = rx_option(1, 0);
+    uint32_t raw = 0;
+    if (menu && *buttons) {
+        AcquireSRWLockShared(&pad_bind_lock);
+        for (int i = 0; i < HOS_SW_N; i++) {
+            if (!(*buttons >> i & 1)) continue;
+            const int a = sampled_pad(i, 0);
+            if (a >= 0 && a < 32) raw |= 1u << a;
+        }
+        ReleaseSRWLockShared(&pad_bind_lock);
+    }
+    InterlockedExchange(&pad_raw_test, (LONG)raw);
+    if (menu || menu_was) test_after_menu |= *buttons;
+    else test_after_menu &= *buttons;
+    menu_was = menu;
+    if (menu) {
+        *buttons = 0;
+        memset(stick, 0, 4 * sizeof *stick);
+    } else *buttons &= ~test_after_menu;
+}
