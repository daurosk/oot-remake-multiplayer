+/// (oot-remake-multiplayer, patch 0020: host/hos_coop_texture.h) A co-op module's texture overrides, kept by the game's
+/// executable (host/coop_texture.c, found there by name): their bytes are read in place of the guest's
+namespace coop_texture {
+using overridden_fn = int (*)(uint64_t address, uint64_t n);
+using overlay_fn = int (*)(uint64_t address, uint8_t* data, uint64_t n);
+struct Fns {
+    overridden_fn overridden = nullptr;
+    overlay_fn overlay = nullptr;
+};
+const Fns& fns() {
+    static const Fns f = [] {
+        Fns x;
+#ifdef _WIN32
+        HMODULE exe = GetModuleHandleW(nullptr);
+        auto look = [exe](const char* name) { return exe ? (void*)GetProcAddress(exe, name) : nullptr; };
+#else
+        auto look = [](const char* name) { return dlsym(RTLD_DEFAULT, name); };
+#endif
+        x.overridden = (overridden_fn)look("hos_coop_texture_overridden");
+        x.overlay = (overlay_fn)look("hos_coop_texture_overlay");
+        if (!x.overridden || !x.overlay) x = Fns{};
+        return x;
+    }();
+    return f;
+}
+/// Whether a module overrides any of the guest bytes [gpu, gpu + n) (below 1 TB the GPU address is the guest's)
+bool overridden(uint64_t gpu, uint64_t n) {
+    const Fns& f = fns();
+    return f.overridden && gpu < (1ull << 40) && f.overridden(gpu, n);
+}
+}  // namespace coop_texture
+
 /// The guest bytes [gpu, gpu + n) in host memory: in place when contiguous, else copied into scratch
-const uint8_t* guest_bytes(uint64_t gpu, uint64_t n, std::vector<uint8_t>& scratch) {
+const uint8_t* guest_bytes_read(uint64_t gpu, uint64_t n, std::vector<uint8_t>& scratch) {
     uint64_t avail = 0;
     const uint8_t* p = host->gpu_ptr(gpu, &avail);
     // (below 1 TB the GPU address is the guest's: the storage as it was at the submit being replayed, where the game has
@@ -963,6 +996,15 @@ const uint8_t* guest_bytes(uint64_t gpu, uint64_t n, std::vector<uint8_t>& scrat
     }
     return scratch.data();
 }
+/// The bytes a texture's storage [gpu, gpu + n) is drawn from: the guest's, with a co-op module's overrides over them
+/// (patch 0020; then always a copy, in scratch)
+const uint8_t* guest_bytes(uint64_t gpu, uint64_t n, std::vector<uint8_t>& scratch) {
+    const uint8_t* p = guest_bytes_read(gpu, n, scratch);
+    if (!coop_texture::overridden(gpu, n)) return p;
+    if (p != scratch.data()) scratch.assign(p, p + n);
+    coop_texture::fns().overlay(gpu, scratch.data(), n);
+    return scratch.data();
+}
 
 void widen_rows(uint8_t* dst, const uint8_t* src, size_t texels, int from, int to) {
     const int comp = from / 3;
@@ -1553,12 +1595,15 @@ bool upload_inner(Texture& tex, const Ranges* dirty) {
     up_route = UP_CPU;
     if (tex.bc) return false;   // (no CPU path into BC3)
     // (the GPU's unswizzle reads guest memory as it is: not where the capture kept the storage as it was at its submit)
-    if (!(tex.gpu < (1ull << 40) && memory_has_shadow(tex.gpu, total)) && upload_unswizzle_gpu(tex, total, dirty))
+    // (patch 0020: a texture a co-op module overrides is read through guest_bytes, on the CPU)
+    const bool coop_over = coop_texture::overridden(tex.gpu, total);
+    if (!coop_over && !(tex.gpu < (1ull << 40) && memory_has_shadow(tex.gpu, total)) &&
+        upload_unswizzle_gpu(tex, total, dirty))
         return up_route = UP_GPU, true;
     const bool linear = nvn_tex_is_linear(&tex.d);
     int widen_from = 0;
     widened(tex.d.format ? vk_format(tex.nvn_format).format : tex.format, &widen_from);
-    if (upload_all_zero(tex, total, dirty, widen_from != 0)) return true;
+    if (!coop_over && upload_all_zero(tex, total, dirty, widen_from != 0)) return true;
     const int src_bpb = tex.bpb;
     const int out_bpb = tex.astc ? 4 : widen_from ? (widen_from == 3 ? 4 : widen_from == 6 ? 8 : 16) : src_bpb;
     const uint32_t copy_layers = tex.type == VK_IMAGE_TYPE_3D ? 1 : tex.layers;
@@ -1633,7 +1678,7 @@ bool upload_inner(Texture& tex, const Ranges* dirty) {
                                                   ? std::clamp(std::thread::hardware_concurrency() / 2, 1u, 8u) : 1u;
                     uint64_t avail = 0;
                     const uint8_t* direct = host->gpu_ptr(tex.gpu + from, &avail);
-                    const bool gather_parts = nthreads > 1 && !(direct && avail >= need) && from < total;
+                    const bool gather_parts = nthreads > 1 && !(direct && avail >= need) && from < total && !coop_over;
                     const uint8_t* src = nullptr;
                     if (gather_parts) {
                     } else if (from < total && total - from >= need) {
@@ -1641,6 +1686,8 @@ bool upload_inner(Texture& tex, const Ranges* dirty) {
                     } else {
                         scratch.assign(need, 0);
                         if (from < total) host->gpu_read(tex.gpu + from, scratch.data(), total - from);
+                        if (from < total && coop_texture::overridden(tex.gpu + from, total - from))   // (patch 0020)
+                            coop_texture::fns().overlay(tex.gpu + from, scratch.data(), total - from);
                         src = scratch.data();
                     }
                     const auto u0 = std::chrono::steady_clock::now();
diff --git a/host/coop_texture.c b/host/coop_texture.c
new file mode 100644
index 00000000..dc9bcdd0
--- /dev/null
+++ b/host/coop_texture.c
@@ -0,0 +1,190 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   (oot-remake-multiplayer, our patch 0020) Texture overrides for the co-op module: hos_coop_texture.h.
+   nvn_native.c tells this file each texture the game makes and finalizes (hos_coop_texture_made / _gone); the module
+   asks for them (hos_coop_textures) and sets overrides on their storage (hos_coop_texture_override), each for one
+   texture by its serial; the renderers read a texture's storage through hos_coop_texture_overlay, which lays the
+   overrides over the guest's bytes. Guest memory is never written here: setting or taking an override marks its pages
+   written (the soft write watch), so the renderers upload the texture again, from the overlay.
+   The same file is in Longshot's host/ through our patch and in our repository (hookshot/src, where the unit tests
+   build it with stand-ins for the two functions below): keep them equal (tests/hookshot/module_test.cpp checks it). */
+#include "hos_coop_texture.h"
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+typedef SRWLOCK coop_lock;
+#define COOP_LOCK_INIT SRWLOCK_INIT
+#define coop_write_lock(l) AcquireSRWLockExclusive(l)
+#define coop_write_unlock(l) ReleaseSRWLockExclusive(l)
+#define coop_read_lock(l) AcquireSRWLockShared(l)
+#define coop_read_unlock(l) ReleaseSRWLockShared(l)
+#define coop_count_set(p, v) InterlockedExchange((p), (v))
+#define coop_count_get(p) InterlockedCompareExchange((p), 0, 0)
+#define COOP_TEXTURE_EXPORT __declspec(dllexport)
+#else
+#include <pthread.h>
+typedef pthread_rwlock_t coop_lock;
+#define COOP_LOCK_INIT PTHREAD_RWLOCK_INITIALIZER
+#define coop_write_lock(l) pthread_rwlock_wrlock(l)
+#define coop_write_unlock(l) pthread_rwlock_unlock(l)
+#define coop_read_lock(l) pthread_rwlock_rdlock(l)
+#define coop_read_unlock(l) pthread_rwlock_unlock(l)
+#define coop_count_set(p, v) __atomic_store_n((p), (v), __ATOMIC_SEQ_CST)
+#define coop_count_get(p) __atomic_load_n((p), __ATOMIC_SEQ_CST)
+#define COOP_TEXTURE_EXPORT __attribute__((visibility("default")))
+#endif
+
+void hos_mark_written(const void *p, size_t n);   /* (hos_mem.c: the GPU mirror picks the pages up) */
+uint8_t *hos_guest_base(void);                    /* (hos_main.c) */
+
+typedef struct {
+    const void *tex;   /* the game's nvn_tex (its key) */
+    HosCoopTexture t;
+} Made;
+typedef struct {
+    uint64_t address, n, serial;   /* serial: the texture it lies on */
+    uint8_t *bytes;
+} Override;
+
+static coop_lock lock = COOP_LOCK_INIT;
+static Made *made;
+static size_t made_n, made_cap;
+static Override *over;
+static size_t over_n, over_cap;
+static uint64_t generation, serials;   /* (lock held) */
+static volatile long overrides;        /* over_n, read without the lock (the renderers' fast path) */
+
+static void drop_at(size_t i) {   /* (lock held) */
+    const Override o = over[i];
+    free(o.bytes);
+    over[i] = over[--over_n];
+    coop_count_set(&overrides, (long)over_n);
+    hos_mark_written(hos_guest_base() + o.address, (size_t)o.n);   /* (the game's own texels uploaded again) */
+}
+
+/* (lock held) every override of that texture (serial), or of any texture (0), that overlaps [a, a + n) */
+static void drop_overlapping(uint64_t a, uint64_t n, uint64_t serial) {
+    for (size_t i = over_n; i-- > 0;)
+        if ((!serial || over[i].serial == serial) && over[i].address < a + n && a < over[i].address + over[i].n)
+            drop_at(i);
+}
+
+static void drop_serial(uint64_t serial) {   /* (lock held) */
+    for (size_t i = over_n; i-- > 0;)
+        if (over[i].serial == serial) drop_at(i);
+}
+
+void hos_coop_texture_made(const void *tex, uint64_t address, uint64_t size, uint32_t width, uint32_t height,
+                           uint32_t levels, uint32_t format) {
+    if (!tex || !address || !size) return;
+    coop_write_lock(&lock);
+    size_t i = 0;
+    while (i < made_n && made[i].tex != tex) i++;
+    if (i == made_n) {
+        if (made_n == made_cap) {
+            const size_t cap = made_cap ? made_cap * 2 : 1024;
+            Made *m = (Made *)realloc(made, cap * sizeof *m);
+            if (!m) {
+                coop_write_unlock(&lock);
+                return;
+            }
+            made = m, made_cap = cap;
+        }
+        made_n++;
+    } else {
+        drop_serial(made[i].t.serial);   /* (made again without a finalize: another texture now) */
+    }
+    made[i].tex = tex;
+    made[i].t.address = address, made[i].t.size = size, made[i].t.serial = ++serials;
+    made[i].t.width = width, made[i].t.height = height, made[i].t.levels = levels, made[i].t.format = format;
+    generation++;
+    coop_write_unlock(&lock);
+}
+
+void hos_coop_texture_gone(const void *tex) {
+    coop_write_lock(&lock);
+    for (size_t i = 0; i < made_n; i++) {
+        if (made[i].tex != tex) continue;
+        drop_serial(made[i].t.serial);
+        made[i] = made[--made_n];
+        generation++;
+        break;
+    }
+    coop_write_unlock(&lock);
+}
+
+COOP_TEXTURE_EXPORT int hos_coop_textures(uint64_t size_min, uint64_t size_max, HosCoopTexture *out, int max,
+                                          uint64_t *gen) {
+    int count = 0;
+    coop_read_lock(&lock);
+    for (size_t i = 0; i < made_n; i++) {
+        if (made[i].t.size < size_min || made[i].t.size > size_max) continue;
+        if (out && count < max) out[count] = made[i].t;
+        count++;
+    }
+    if (gen) *gen = generation;
+    coop_read_unlock(&lock);
+    return count;
+}
+
+COOP_TEXTURE_EXPORT int hos_coop_texture_override(uint64_t address, uint64_t serial, const void *bytes, uint64_t n) {
+    if (!n || !serial) return 0;
+    int ok = 0;
+    coop_write_lock(&lock);
+    if (!bytes) {
+        drop_overlapping(address, n, serial);
+        ok = 1;
+    } else {
+        size_t i = 0;   /* only inside the storage of the texture of that serial, while the game has it */
+        while (i < made_n && made[i].t.serial != serial) i++;
+        const int inside = i < made_n && made[i].t.address <= address && address + n <= made[i].t.address + made[i].t.size;
+        uint8_t *copy = inside ? (uint8_t *)malloc((size_t)n) : NULL;
+        if (copy && over_n == over_cap) {
+            const size_t cap = over_cap ? over_cap * 2 : 64;
+            Override *o = (Override *)realloc(over, cap * sizeof *o);
+            if (o) over = o, over_cap = cap;
+        }
+        if (copy && over_n < over_cap) {
+            memcpy(copy, bytes, (size_t)n);
+            drop_overlapping(address, n, 0);
+            over[over_n].address = address, over[over_n].n = n, over[over_n].serial = serial, over[over_n].bytes = copy;
+            over_n++;
+            coop_count_set(&overrides, (long)over_n);
+            hos_mark_written(hos_guest_base() + address, (size_t)n);   /* (uploaded again, from the overlay) */
+            ok = 1;
+        } else {
+            free(copy);
+        }
+    }
+    coop_write_unlock(&lock);
+    return ok;
+}
+
+/* For the renderers (the Vulkan one finds it in the exe by name): whether any override overlaps [address, address+n) */
+COOP_TEXTURE_EXPORT int hos_coop_texture_overridden(uint64_t address, uint64_t n) {
+    if (!coop_count_get(&overrides)) return 0;
+    int hit = 0;
+    coop_read_lock(&lock);
+    for (size_t i = 0; i < over_n && !hit; i++) hit = over[i].address < address + n && address < over[i].address + over[i].n;
+    coop_read_unlock(&lock);
+    return hit;
+}
+
+/* The overrides over `data`, which holds guest memory [address, address + n): how many lay on it */
+COOP_TEXTURE_EXPORT int hos_coop_texture_overlay(uint64_t address, uint8_t *data, uint64_t n) {
+    if (!coop_count_get(&overrides) || !data) return 0;
+    int laid = 0;
+    coop_read_lock(&lock);
+    for (size_t i = 0; i < over_n; i++) {
+        const Override *o = &over[i];
+        const uint64_t lo = o->address > address ? o->address : address;
+        const uint64_t hi = o->address + o->n < address + n ? o->address + o->n : address + n;
+        if (lo >= hi) continue;
+        memcpy(data + (lo - address), o->bytes + (lo - o->address), (size_t)(hi - lo));
+        laid++;
+    }
+    coop_read_unlock(&lock);
+    return laid;
+}
diff --git a/host/hos_coop_texture.h b/host/hos_coop_texture.h
new file mode 100644
index 00000000..182391d8
--- /dev/null
+++ b/host/hos_coop_texture.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Texture overrides (oot-remake-multiplayer, docs/hookshot.md "Texture overrides"; our patch 0020): a module may have
+   Longshot's renderer draw a texture with other texels, while the game's memory keeps the game's own. Nothing of the
+   game is written: the renderer takes the module's bytes where it would read the texture's storage, and uploads the
+   texture again when an override is set or taken away. The Link customizer paints Link's gear and tunic with it.
+
+   Exports of the game's executable, found by name (GetProcAddress of the exe, dlsym on Linux), any thread; for a
+   module:
+   - hos_coop_textures: the textures the game has made (nvnTextureInitialize, until nvnTextureFinalize) whose storage
+     size is in [size_min, size_max]: their storage's guest address, size, width, height, levels and NVN format, and a
+     serial, new each time a texture is made (one made again at the same address has another). Fills
+     at most `max` (out may be NULL with max 0), returns how many there are; *generation (when not NULL) = a number that
+     changes whenever a texture is made or finalized, so a caller asks again only then.
+   - hos_coop_texture_override: from now on the renderer reads `n` bytes from `bytes` (copied: the caller may free
+     them) in place of guest memory [address, address + n), for the texture of that serial (from hos_coop_textures);
+     bytes NULL takes away that texture's overrides that overlap the range. 1 when done; 0 when the game no longer has
+     a texture of that serial or the range is not inside its storage (nothing set): a texture made again over the same
+     storage has another serial, so a module's late call never lands on it. When the game finalizes that texture (or
+     makes it again), its overrides go with it (the memory may hold something else next). One texture's override:
+     another texture over the same storage (an alias) shows it too while it lasts, and loses it with that texture.
+   For the renderers (host/coop_texture.c): hos_coop_texture_overridden(address, n), whether any override overlaps that
+   range, and hos_coop_texture_overlay(address, data, n), the overrides laid over `data` (guest memory of that range).
+   Generic: any module, any texture, with no further Longshot build. Both renderers take them (Vulkan, WebGPU).
+   The same file is in Longshot's host/ through our patch and in our repository (hookshot/src): keep them equal
+   (tests/hookshot/module_test.cpp checks it). Plain C. */
+#ifndef HOS_COOP_TEXTURE_H
+#define HOS_COOP_TEXTURE_H
+#include <stdint.h>
+
+#define HOS_COOP_TEXTURE_VERSION 1
+
+typedef struct HosCoopTexture {
+    uint64_t address;   /* the storage's guest address (where its texels start) */
+    uint64_t size;      /* the storage's size in bytes, every level and layer */
+    uint64_t serial;    /* new each time a texture is made */
+    uint32_t width, height, levels, format;   /* format: the NVN format number */
+} HosCoopTexture;
+
+typedef int (*hos_coop_textures_fn)(uint64_t size_min, uint64_t size_max, HosCoopTexture *out, int max,
+                                    uint64_t *generation);
+typedef int (*hos_coop_texture_override_fn)(uint64_t address, uint64_t serial, const void *bytes, uint64_t n);
+
+#endif
