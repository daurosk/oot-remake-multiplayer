# Writes coop_version.h with the co-op commit built in ("coop: build ..." in the log).
# Run as a script on every build (cmake -P), not once at configure: a configure-time
# `git describe` stays cached, so 0.11.3's module said v0.11.2-18-gab129f5b. The header
# is rewritten only when the string changes, so an unchanged tree recompiles nothing.
#
#   cmake -DCOOP_GIT_DIR=<repo> -DCOOP_VERSION_PREFIX=<word, or empty> -DCOOP_VERSION_OUT=<file> -P coop_version.cmake
#
# Used by lichii/hook/core.cmake (the emulator) and hookshot/CMakeLists.txt (the module).
execute_process(COMMAND git -C "${COOP_GIT_DIR}" describe --tags --always --dirty
    OUTPUT_VARIABLE _coop_version OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(COOP_VERSION_PREFIX)
    set(COOP_VERSION_PREFIX "${COOP_VERSION_PREFIX} ")  # "hookshot v0.11.4"
endif()
if(NOT _coop_version)
    set(_coop_version "unknown")
endif()
set(_coop_text "// Generated by cmake/coop_version.cmake on each build; do not edit.\n#pragma once\n#define LICHII_COOP_VERSION \"${COOP_VERSION_PREFIX}${_coop_version}\"\n")
set(_coop_old "")
if(EXISTS "${COOP_VERSION_OUT}")
    file(READ "${COOP_VERSION_OUT}" _coop_old)
endif()
if(NOT _coop_old STREQUAL _coop_text)
    file(WRITE "${COOP_VERSION_OUT}" "${_coop_text}")
endif()
