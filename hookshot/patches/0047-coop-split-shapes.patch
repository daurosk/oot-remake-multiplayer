@@ -108,9 +108,23 @@ int main(int argc, char **argv) {
             got = subprocess.check_output([str(exe), *args_], text=True, env=old_cap).strip()
             if got != expect:
                 bad.append("HOS_WIDE_MAX_PX=8294400, %s: %s, expected %s" % (" ".join(args_), got, expect))
+        # (co-op split screen: HOS_ASPECT or HOS_OUTPUT_RES set, shapes down to 1:2; a half of a 16:9 screen is about 8:9.
