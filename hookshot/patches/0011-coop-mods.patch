From 1cc39d2a27dd2ab7b6d1986a2ca9fe7785c90a58 Mon Sep 17 00:00:00 2001
From: coop-fetch <coop-fetch@localhost>
Date: Fri, 13 Nov 2026 00:35:10 -0900
Subject: [PATCH] Co-op mods: the Mods tab's order and switches, read at the
 start

oot-remake-multiplayer's patch 0011 (docs/mods.md). The co-op module's Mods
tab cannot move or rename a mod while the game has its files open, and the
mods are indexed before the module is loaded. host/mods.c now reads
<mods>/coop-mods.list (written by the tab: the order, and the mods turned
off) before it sorts and indexes the mods, and writes what this run indexed
into <mods>/coop-mods.applied, from which the tab says whether a restart is
needed. host/hos_coop_mods.h (plain C, header only) is the two files' format,
the same file as the module's. Without a list file nothing changes. Host
code only: no lift change.

A mod with ExeFS patches is used at each start as the game was built for it
(hos_coop_mods_as_built, against exefs_patches.txt): its code is in the game
only after a build, so a switch made since (the game then started from
longshot.exe, which does not build) waits for the next build. Its code in
the game: its files stay on; patch files the build did not take: its files
stay off. The switch is kept as set, one log line says so. exefs_status now
runs before the index, and the index, the size table and coop-mods.applied
follow start_enabled (this start) instead of the switch.

A mod whose patch files changed since the build (one not in the list with
its hash, as exefs_status counts it) keeps its files on (its old code is in
the game) and one log line says a build is needed.

A list with a "default off" line (co-op's Original game, which names every
mod off) leaves out a mod it does not name too, so a mod put into the
folder after the list was written stays out (player report 266).
---
 host/hos_coop_mods.h | 227 +++++++++++++++++++++++++++++++++++++++++++
 host/mods.c          | 100 ++++++++++++++++++-
 2 files changed, 322 insertions(+), 5 deletions(-)
 create mode 100644 host/hos_coop_mods.h

diff --git a/host/hos_coop_mods.h b/host/hos_coop_mods.h
new file mode 100644
index 00000000..cdc49726
--- /dev/null
+++ b/host/hos_coop_mods.h
@@ -0,0 +1,227 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   The mods list between the co-op module's Mods tab and Hookshot's mod loader (oot-remake-multiplayer, docs/mods.md).
+
+   Hookshot indexes its mods folder once, at the start, before the module is loaded, and keeps the game's files open
+   while it runs. So the tab never renames or moves a mod: it writes one small file into the mods folder, and Hookshot's
+   host/mods.c (our patch 0011) reads it at the next start:
+
+     <mods>/coop-mods.list      written by the module: the order and the switches
+         coop-mods 1
+         on <name>              first row = wins a file two mods have (it is indexed last)
+         off <name>             left out
+         default off            (optional, any line after the first) a mod the list does not name is off too
+       <name> is the mod's name as Hookshot logs it: its path under the mods folder with '/'. A mod the list does not
+       name is on and keeps Hookshot's own order (by name) under the named ones; with "default off" it is left out,
+       as an "off" row would (co-op's Original game, coop_original.h: a mod put into the folder after the switch went on
+       stays out too, player report 266). Lines it does not know are skipped (an older reader skips "default off").
+
+     <mods>/coop-mods.applied   written by Hookshot at each start: what this run indexed
+         coop-mods-applied 1 <process id>
+         on <files> <name>      in the order indexed (the last one wins)
+         off <name>
+
+   The same file is in Hookshot's host/ through our patch and in our repository (hookshot/src): keep them equal
+   (tests/hookshot/mods_test.cpp checks it). Plain C, header only, no Hookshot or co-op include. */
+#ifndef HOS_COOP_MODS_H
+#define HOS_COOP_MODS_H
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+
+#define HOS_COOP_MODS_VERSION 1
+#define HOS_COOP_MODS_LIST_FILE "coop-mods.list"
+#define HOS_COOP_MODS_DEFAULT_OFF "default off"   /* the line that leaves the mods the list does not name out */
+#define HOS_COOP_MODS_APPLIED_FILE "coop-mods.applied"
+#define HOS_COOP_MODS_MAX 256    /* rows read; more are skipped */
+#define HOS_COOP_MODS_NAME 260   /* a name with its 0 (MAX_PATH) */
+/* The most a list file can hold that is read: a caller's buffer for it. */
+#define HOS_COOP_MODS_TEXT_MAX (HOS_COOP_MODS_MAX * (HOS_COOP_MODS_NAME + 8) + 64)
+
+typedef struct HosCoopModsRow {
+    char name[HOS_COOP_MODS_NAME];
+    int off;
+} HosCoopModsRow;
+
+typedef struct HosCoopModsList {
+    int count;
+    int default_off;   /* 1: the list has a "default off" line: a mod it does not name is off (hos_coop_mods_rank) */
+    HosCoopModsRow rows[HOS_COOP_MODS_MAX];
+} HosCoopModsList;
+
+/* Names are compared as Hookshot sorts them: ASCII letters without case; '\' counts as '/'. */
+static inline int hos_coop_mods_fold(int c) {
+    if (c == '\\') return '/';
+    return c >= 'A' && c <= 'Z' ? c - 'A' + 'a' : c;
+}
+static inline int hos_coop_mods_same(const char *a, const char *b) {
+    for (;; a++, b++) {
+        if (hos_coop_mods_fold((unsigned char)*a) != hos_coop_mods_fold((unsigned char)*b)) return 0;
+        if (!*a) return 1;
+    }
+}
+
+/* Reads a list file's text (n bytes; no 0 needed). 1 when it is a list of this version; else 0 and an empty list. */
+static inline int hos_coop_mods_parse(const char *text, size_t n, HosCoopModsList *out) {
+    size_t at = 0;
+    int line_no = 0;
+    out->count = 0;
+    out->default_off = 0;
+    while (at < n) {
+        size_t end = at, len;
+        const char *line = text + at;
+        while (end < n && text[end] != '\n') end++;
+        len = end - at;
+        at = end + 1;
+        if (len && line[len - 1] == '\r') len--;
+        if (line_no++ == 0) {
+            if (len != 11 || memcmp(line, "coop-mods 1", 11)) return 0;
+            continue;
+        }
+        {
+            int off;
+            int i, known = 0;
+            if (len == sizeof HOS_COOP_MODS_DEFAULT_OFF - 1 && !memcmp(line, HOS_COOP_MODS_DEFAULT_OFF, len)) {
+                out->default_off = 1;
+                continue;
+            }
+            if (len > 3 && !memcmp(line, "on ", 3)) off = 0, line += 3, len -= 3;
+            else if (len > 4 && !memcmp(line, "off ", 4)) off = 1, line += 4, len -= 4;
+            else continue;
+            if (len >= HOS_COOP_MODS_NAME || out->count >= HOS_COOP_MODS_MAX) continue;
+            memcpy(out->rows[out->count].name, line, len);
+            out->rows[out->count].name[len] = 0;
+            for (i = 0; i < out->count && !known; i++)   /* (a name twice: its first row counts) */
+                known = hos_coop_mods_same(out->rows[i].name, out->rows[out->count].name);
+            if (known) continue;
+            out->rows[out->count++].off = off;
+        }
+    }
+    return line_no > 0;
+}
+
+/* A mod's place: -1 = off (an "off" row, or not in a "default off" list); 0 = not in the list (Hookshot's own order,
+   under the listed ones); else the higher wins (the list's first row has the highest). Mods are indexed by rising rank,
+   then by name. */
+static inline int hos_coop_mods_rank(const HosCoopModsList *list, const char *name) {
+    int i;
+    for (i = 0; i < list->count; i++)
+        if (hos_coop_mods_same(list->rows[i].name, name)) return list->rows[i].off ? -1 : list->count - i;
+    return list->default_off ? -1 : 0;
+}
+
+/* The applied file's lines (each with its '\n'); what snprintf returns. */
+static inline int hos_coop_mods_applied_head(char *out, size_t cap, unsigned long pid) {
+    return snprintf(out, cap, "coop-mods-applied %d %lu\n", HOS_COOP_MODS_VERSION, pid);
+}
+static inline int hos_coop_mods_applied_row(char *out, size_t cap, const char *name, int files) {   /* files < 0: off */
+    return files < 0 ? snprintf(out, cap, "off %s\n", name) : snprintf(out, cap, "on %d %s\n", files, name);
+}
+
+/* Co-op's own packs (the puppet pack, the HUD pack): the kit keeps them on and builds the game with them; never listed.
+   A name whose last part starts with coop-puppet, coop_hud or coop-hud. */
+static inline int hos_coop_mods_own(const char *name) {
+    static const char *const own[] = {"coop-puppet", "coop_hud", "coop-hud"};
+    const char *leaf = name, *p;
+    size_t i, k;
+    for (p = name; *p; p++)
+        if (*p == '/' || *p == '\\') leaf = p + 1;
+    for (i = 0; i < sizeof own / sizeof own[0]; i++) {
+        for (k = 0; own[i][k] && hos_coop_mods_fold((unsigned char)leaf[k]) == own[i][k]; k++) {}
+        if (!own[i][k]) return 1;
+    }
+    return 0;
+}
+
+/* A mod's code against the game's build (player report: a code mod switched in the Mods tab, then the game started from
+   longshot.exe, which does not build). The game is compiled ahead of time, and a mod's ExeFS patches go into it only when
+   it is built (the kit's Start Squadala builds again when they changed). The build lists what it took in
+   <game>/exefs_patches.txt (nx2/exefs_patches.py): "<mod>\t<file>\t<hash>\t<kind>[\t<note>]" a line, '#' a comment,
+   <kind> code or data (applied), other, empty or bad (not applied). The build lists only the mods that were on, and writes
+   no list when no mod had a patch file (nx2/make_game.py): no list reads as an empty one (n = 0). */
+#define HOS_COOP_MODS_BUILT_NONE 0   /* the list names none of its files: the game was built while it was off (or gone) */
+#define HOS_COOP_MODS_BUILT_CODE 1   /* code or data of it applied: its code is in the game */
+#define HOS_COOP_MODS_BUILT_NAMED 2  /* named, nothing applied (another game version's, empty): its code changes nothing */
+#define HOS_COOP_MODS_BUILT_CHANGED 3   /* code of it applied, but a patch file it has now is not as built (put in or
+                                           changed since: hos_coop_mods_built_changed): the game runs its old code */
+static inline int hos_coop_mods_built(const char *list, size_t n, const char *name) {
+    size_t at = 0;
+    int named = 0;
+    while (at < n) {
+        size_t end = at, len, f = 0, field = 0;
+        const char *line = list + at;
+        while (end < n && list[end] != '\n') end++;
+        len = end - at;
+        at = end + 1;
+        if (!len || line[0] == '#') continue;
+        while (f < len && line[f] != '\t') f++;
+        if (f == len || strlen(name) != f) continue;
+        {
+            size_t k;
+            int same = 1;
+            for (k = 0; k < f && same; k++)
+                same = hos_coop_mods_fold((unsigned char)line[k]) == hos_coop_mods_fold((unsigned char)name[k]);
+            if (!same) continue;
+        }
+        named = 1;
+        for (f = 0; f < len && field < 3; f++)   /* (the fourth field: the kind) */
+            if (line[f] == '\t') field++;
+        if (field == 3 && f + 4 <= len && (!memcmp(line + f, "code", 4) || !memcmp(line + f, "data", 4)))
+            return HOS_COOP_MODS_BUILT_CODE;
+    }
+    return named ? HOS_COOP_MODS_BUILT_NAMED : HOS_COOP_MODS_BUILT_NONE;
+}
+
+/* FNV-1a 32 of a file's bytes, as the build and host/mods.c exefs_status hash a patch file: start with
+   HOS_COOP_MODS_FNV32_START, feed each block. */
+#define HOS_COOP_MODS_FNV32_START 0x811C9DC5u
+static inline unsigned long hos_coop_mods_fnv32(unsigned long h, const void *data, size_t n) {
+    const unsigned char *p = (const unsigned char *)data;
+    size_t i;
+    for (i = 0; i < n; i++) h = ((h ^ p[i]) * 0x01000193u) & 0xFFFFFFFFu;
+    return h;
+}
+
+/* Whether the list has this patch file of this mod as it is now: its file name and its hash (exefs_status's test). */
+static inline int hos_coop_mods_built_file(const char *list, size_t n, const char *name, const char *file, unsigned long hash) {
+    char want[24];
+    size_t at = 0, name_n = strlen(name), file_n = strlen(file), want_n;
+    want_n = (size_t)snprintf(want, sizeof want, "\t%08lx\t", hash & 0xFFFFFFFFu);
+    while (at < n) {
+        size_t end = at, len, k;
+        const char *line = list + at;
+        int same = 1;
+        while (end < n && list[end] != '\n') end++;
+        len = end - at;
+        at = end + 1;
+        if (len < name_n + 1 + file_n + want_n || line[name_n] != '\t') continue;
+        for (k = 0; k < name_n && same; k++)
+            same = hos_coop_mods_fold((unsigned char)line[k]) == hos_coop_mods_fold((unsigned char)name[k]);
+        for (k = 0; k < file_n && same; k++)
+            same = hos_coop_mods_fold((unsigned char)line[name_n + 1 + k]) == hos_coop_mods_fold((unsigned char)file[k]);
+        if (same && !memcmp(line + name_n + 1 + file_n, want, want_n)) return 1;
+    }
+    return 0;
+}
+
+/* A mod's build state with its patch files now: CODE becomes CHANGED when `waiting` of them (files the list does not
+   have as they are: hos_coop_mods_built_file) are not in the game. */
+static inline int hos_coop_mods_built_changed(int built, int waiting) {
+    return built == HOS_COOP_MODS_BUILT_CODE && waiting > 0 ? HOS_COOP_MODS_BUILT_CHANGED : built;
+}
+
+/* Whether a mod's files are used this start: as the game was built for it, not as switched since. A mod whose code is in
+   the game keeps its files on (its code reads them); a mod with ExeFS patch files the build did not take keeps its files
+   off (its files without its code: Character Select's picks do nothing, and its tables lack what the kit's start merges
+   in). The next game build (Start Squadala) takes the switch, code and files together. A mod whose code changed since the
+   build (CHANGED: a new release put in by hand) runs its old code: its old files are gone, and its code without files
+   is worse than with newer ones, so its files stay on, and the start and the Mods tab say a build is needed. Co-op's
+   own packs: as switched. on: the switch; built: hos_coop_mods_built, then hos_coop_mods_built_changed; patch_files:
+   its .ips and .pchtxt files. */
+static inline int hos_coop_mods_as_built(int on, int built, int patch_files, const char *name) {
+    if (hos_coop_mods_own(name)) return on;
+    if (built == HOS_COOP_MODS_BUILT_CODE || built == HOS_COOP_MODS_BUILT_CHANGED) return 1;
+    if (built == HOS_COOP_MODS_BUILT_NONE && patch_files > 0) return 0;
+    return on;
+}
+
+#endif
diff --git a/host/mods.c b/host/mods.c
index c5f63179..6db36c81 100644
--- a/host/mods.c
+++ b/host/mods.c
@@ -71,6 +71,7 @@ static Entry *find(const char *key) {
 typedef struct {
     char path[MAX_PATH], name[MAX_PATH];
     int enabled, start_enabled;
+    int coop_rank;                          /* (co-op, patch 0011) the co-op Mods tab's rank: coop_mods_rank */
     int romfs, exefs, cheats;               /* what it has */
     int files, replaced, added, overridden; /* its RomFS files; those the game has, those it has not; those a mod below takes */
     int exefs_files, exefs_built, exefs_waiting, exefs_other, exefs_bad;   /* its ExeFS patch files, by their state */
@@ -757,9 +758,9 @@ static int fit_sizes(void) {
             continue;
         }
         tables++;
-        if (!shipped[s].other && mods[shipped[s].mod].enabled) {
+        if (!shipped[s].other && mods[shipped[s].mod].start_enabled) {
             merged += restbl_merge(out, base, t);
-        } else if (mods[shipped[s].mod].enabled) {   /* (another version's: the entries of its own mod's files) */
+        } else if (mods[shipped[s].mod].start_enabled) {   /* (another version's: the entries of its own mod's files) */
             for (size_t i = 0; i < table_cap; i++) {
                 char key[MAX_PATH];
                 uint32_t size;
@@ -845,6 +846,91 @@ static void find_sizes(void) {
 static void mod_text(Mod *m);
 
 /* hos_main.c, once the image is loaded (image_path: unused; ExeFS patches are applied when the game is built) */
+/* (oot-remake-multiplayer, patch 0011, docs/mods.md) The co-op module's Mods tab cannot move or rename a mod while the
+   game has its files open, and the mods are indexed before the module is loaded. So the tab writes its order and
+   switches into <mods>\coop-mods.list, read here at the start, and this run's result goes into
+   <mods>\coop-mods.applied, from which the tab knows what the running game uses (and whether a restart is needed).
+   Longshot 3.1 has its own list (mods.json, the Insert menu's Mods tab): without coop-mods.list that list is used as it
+   is; with it, the co-op list's order and switches go over it (its first row wins a file two mods have: it goes last,
+   as the lowest row of mods.json does) and the mods it does not name keep mods.json's order and switch, above it. The
+   two files' lines: hos_coop_mods.h. */
+#include "hos_coop_mods.h"
+static HosCoopModsList coop_list;
+static int coop_rank_cmp(const void *a, const void *b) {
+    const Mod *x = (const Mod *)a, *y = (const Mod *)b;
+    if (x->coop_rank != y->coop_rank) return x->coop_rank < y->coop_rank ? -1 : 1;
+    return x->start_enabled < y->start_enabled ? -1 : x->start_enabled > y->start_enabled;   /* (the place mods.json gave) */
+}
+static void coop_mods_rank(const char *root) {   /* each mod's rank from the tab's list (-1: off), over mods.json's */
+    static char text[HOS_COOP_MODS_TEXT_MAX];
+    char path[MAX_PATH];
+    DWORD n = 0;
+    snprintf(path, sizeof path, "%s\\%s", root, HOS_COOP_MODS_LIST_FILE);
+    HANDLE f = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (f == INVALID_HANDLE_VALUE) return;
+    if (!ReadFile(f, text, sizeof text, &n, NULL)) n = 0;
+    CloseHandle(f);
+    if (!hos_coop_mods_parse(text, n, &coop_list)) {
+        hos_log("mods: %s is not a mods list: left out (mods.json's order and switches)", path);
+        return;
+    }
+    hos_log("mods: %s: %d rows (the co-op Mods tab's order and switches, over mods.json's)%s", path, coop_list.count,
+            coop_list.default_off ? "; default off: a mod it does not name is off too (Original game)" : "");
+    for (int i = 0; i < nmods; i++) {
+        mods[i].coop_rank = hos_coop_mods_rank(&coop_list, mods[i].name);
+        mods[i].start_enabled = i;   /* (scratch: the place in mods.json's order, for a stable sort) */
+    }
+    qsort(mods, (size_t)nmods, sizeof *mods, coop_rank_cmp);
+    for (int i = 0; i < nmods; i++) {
+        if (mods[i].coop_rank < 0) mods[i].enabled = 0;
+        else if (mods[i].coop_rank > 0) mods[i].enabled = 1;
+    }
+    sync_tab();   /* (the Mods tab starts from this order: no change of this run) */
+}
+static void coop_mods_applied(const char *root) {   /* what this run indexed, for the co-op tab */
+    char path[MAX_PATH], line[MAX_PATH + 32];
+    DWORD done;
+    snprintf(path, sizeof path, "%s\\%s", root, HOS_COOP_MODS_APPLIED_FILE);
+    HANDLE f = CreateFileA(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (f == INVALID_HANDLE_VALUE) return;
+    int n = hos_coop_mods_applied_head(line, sizeof line, (unsigned long)GetCurrentProcessId());
+    WriteFile(f, line, (DWORD)n, &done, NULL);
+    for (int i = 0; i < nmods; i++) {
+        n = hos_coop_mods_applied_row(line, sizeof line, mods[i].name, mods[i].start_enabled ? mods[i].files : -1);
+        WriteFile(f, line, (DWORD)n, &done, NULL);
+    }
+    CloseHandle(f);
+}
+/* A mod with ExeFS patches is used this start as the game was built for it (hos_coop_mods_as_built): its code is compiled
+   into the game only by a build, and the co-op Mods tab (or mods.json) may have switched it since, with the game then
+   started from longshot.exe, which does not build. Its code without its files, or its files without its code, is a game
+   no build made (Character Select: picks that do nothing, or its tables without the rows the kit's start merges in). So
+   the switch waits for the next build (Start Squadala builds when a mod's code patches changed), code and files
+   together. The switch itself is kept as set: the tab and the build read it. Runs after exefs_status (m->exefs_files) */
+static void coop_mods_as_built(const char *game_dir) {
+    char list_path[MAX_PATH];
+    snprintf(list_path, sizeof list_path, "%sexefs_patches.txt", game_dir);
+    char *built = read_text(list_path);   /* (none: the game was built when no mod had a patch file) */
+    for (int i = 0; i < nmods; i++) {
+        Mod *m = &mods[i];
+        if (!m->exefs) continue;
+        /* (exefs_waiting: its patch files the list does not have as they are now, exefs_status) */
+        const int state = hos_coop_mods_built_changed(hos_coop_mods_built(built ? built : "", built ? strlen(built) : 0, m->name),
+                                                      m->exefs_waiting);
+        const int use = hos_coop_mods_as_built(m->enabled, state, m->exefs_files, m->name);
+        if (state == HOS_COOP_MODS_BUILT_CHANGED && !hos_coop_mods_own(m->name))
+            hos_log("mods: %s: its code patches changed since the game was built (%d file%s not in it): the game runs its old "
+                    "code with the mod's files as they are now until it is built again: start the game with Start Squadala",
+                    m->name, m->exefs_waiting, m->exefs_waiting == 1 ? "" : "s");
+        if (use == m->start_enabled) continue;
+        m->start_enabled = use;
+        hos_log("mods: %s: switched %s in the Mods tab, but the game was built %s its code: it stays %s this start, as the game "
+                "was built for it. Its code changes only with a game build: start the game with Start Squadala", m->name,
+                m->enabled ? "on" : "off", use ? "with" : "without", use ? "on" : "off");
+    }
+    free(built);
+}
+
 void hos_mods_init(const char *image_path) {
     (void)image_path;
     char game_dir[MAX_PATH];
@@ -862,15 +948,19 @@ void hos_mods_init(const char *image_path) {
     find_mods(root_dir, "", 0);
     if (!nmods) {
         hos_log("mods: none in %s (a mod: <name>\\romfs, <name>\\exefs or <name>\\cheats)", root_dir);
+        coop_mods_applied(root_dir);   /* (co-op) */
         return;
     }
