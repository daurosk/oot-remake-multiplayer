From 6a023e980eb5ccea7fcc1b2cc1628d08bb1cbaf4 Mon Sep 17 00:00:00 2001
From: daurosk <354202035+daurosk@users.noreply.github.com>
Date: Sun, 8 Nov 2026 17:46:31 -0900
Subject: [PATCH] coop: hand the game's camera to the co-op hook

With LICHII_COOP on, each draw calls CoopCamera::Track from the hook's
coop_camera_track.h after its pipeline is configured. It looks for the same
camera buffer as the DLSS path (TrackOcarinaCamera) without needing DLSS,
so co-op can draw player markers in the world.
---
 src/video_core/renderer_vulkan/vk_rasterizer.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
index bdf5cbc779..65ca498178 100644
--- a/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -134,6 +134,9 @@
         VideoCommon::OneFollower::Lend(VideoCommon::OneFollower::LentOp::op, onef_call);           \
         return std::move(*onef_result);                                                            \
     }
+#ifdef LICHII_COOP
+#include "coop_camera_track.h"
+#endif
 
 namespace Vulkan {
 
@@ -2980,6 +2983,10 @@ void RasterizerVulkan::PrepareDraw(bool is_indexed, Func&& draw_func, bool is_in
         }
     }
 
+#ifdef LICHII_COOP
+    CoopCamera::Track(texture_cache, buffer_cache, device_memory, maxwell3d->regs,
+                      render_trace_frame);
+#endif
     if (VideoCommon::MemStageShadow::g_on.load(std::memory_order_relaxed) && !ring_on &&
         OcarinaTemporalEnabled()) [[unlikely]] {
         VerifyTrackerRecord(tracker_record ? &*tracker_record : nullptr);
