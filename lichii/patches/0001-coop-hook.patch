     }
 
     // EDEN_NX2_FRAME_CAPTURE=<dir>: every 120th present, save what the renderer shows as
diff --git a/src/yuzu/CMakeLists.txt b/src/yuzu/CMakeLists.txt
index f96bd5be8e..d3104c7085 100644
--- a/src/yuzu/CMakeLists.txt
+++ b/src/yuzu/CMakeLists.txt
@@ -516,4 +516,9 @@ if (TARGET nxformat::static_nozstd)
     target_link_libraries(yuzu PRIVATE nxformat::static_nozstd)
     target_compile_definitions(yuzu PRIVATE LICHII_NX_TOOLS)
 endif()
+
+if (LICHII_COOP)
+    include("${LICHII_COOP_DIR}/lichii/hook/qt.cmake")
+endif()
+
 create_target_directory_groups(yuzu)
