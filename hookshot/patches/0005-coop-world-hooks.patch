@@ -969,6 +969,9 @@ class Lifter:
         # (hookshot) C emitted right after the instruction at a guest address ({pc: text}): a game patch that adds to an
         # instruction instead of replacing a function (nx2/oot_wide.py). Only after plain instructions (kind "op")
         self.after = {}
+        # (oot-remake-multiplayer's patch 0005, nx2/coop_world_wraps.py) wrapped functions ({entry: wrap id}): every call and
+        # the indirect table reach hos_coop_w_<entry> (a64_hooks.c), which calls the co-op module before and after f_<entry>
+        self.wraps = {}
         self.funcs = {}       # entry -> (body {pc: kind}, labels set)
         self.jt = {}          # br pc -> [targets]
         self.jt_missing = {}      # br pc -> its register, for BRs whose table address was not found
@@ -1479,6 +1482,8 @@ class Lifter:
     def fname(self, t):
         # Hooked addresses keep their f_ name too (a64_hooks.c defines it as a tail call of the hook), so hooking
         # or unhooking a function changes one small file instead of every call site in the lifted code.
+        if t in getattr(self, "wraps", ()):   # (patch 0005: the wrapper; the function itself keeps its f_ name and text)
+            return "hos_coop_w_%08x" % t
         return "f_%08x" % t
 
     # ---- emission ------------------------------------------------------------------------------------
@@ -1823,6 +1828,11 @@ class Lifter:
             f.write('#include "a64.h"\n')
             f.write("".join("void %s(Ctx *A64_NOESC);\n" % n for n in sorted(set(self.hooks.values()))))
             f.write("".join("void f_%08x(Ctx *A64_NOESC c) { TAILCALL(%s); }\n" % (a, n) for a, n in sorted(self.hooks.items())))
+            if getattr(self, "wraps", None):   # (patch 0005, host/coop_world.c: the module before (1: it did the call's work), after)
+                f.write("int hos_coop_wrap(uint32_t id, int phase, Ctx *A64_NOESC c);\n")
+                f.write("".join("void f_%08x(Ctx *A64_NOESC);\nvoid hos_coop_w_%08x(Ctx *A64_NOESC c) { "
+                                "if (!hos_coop_wrap(%du, 0, c)) f_%08x(c); hos_coop_wrap(%du, 1, c); }\n" % (a, a, w, a, w)
+                                for a, w in sorted(self.wraps.items())))
 
     def report(self):
         nins = sum(len(b) for b, _ in self.funcs.values())
