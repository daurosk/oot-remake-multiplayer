From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: coop-fetch <coop-fetch@localhost>
Date: Thu, 12 Nov 2026 13:00:23 -0900
Subject: [PATCH] Co-op world hooks: game events straight to the co-op module

host/coop_world.c hands an event from a lift-time hook to the co-op
module's optional export hos_coop_world (hos_coop_world.h), kept once
the module answers HOS_COOP_WORLD_HELLO with 1. First event: the AI
pause counter start (nx2/coop_platform_lift.py, main+0x5e6778) goes to
the module as HOS_COOP_WORLD_COUNTER_START instead of into a ring in
the game's heap, so host/coop_platform_ring.c, the game malloc and the
ring pointer at main+0x3c46780 are not used on Hookshot any more.
---
 host/coop_platform_ring.c | 19 ------------------
 host/coop_world.c         | 42 +++++++++++++++++++++++++++++++++++++++
 host/hos_coop_world.h     | 23 +++++++++++++++++++++
 nx2/coop_platform_lift.py | 15 +++++++-------
 4 files changed, 73 insertions(+), 26 deletions(-)
 delete mode 100644 host/coop_platform_ring.c
 create mode 100644 host/coop_world.c
 create mode 100644 host/hos_coop_world.h

diff --git a/host/coop_platform_ring.c b/host/coop_platform_ring.c
deleted file mode 100644
index b241703..0000000
--- a/host/coop_platform_ring.c
+++ /dev/null
@@ -1,19 +0,0 @@
-/* (oot-remake-multiplayer's patch 0003, nx2/coop_platform_lift.py) A started AI pause counter goes into co-op's ring.
-
-   The same ring the emulator's cave fills (lichii/hook/coop_counter.s): its address is the u64 at main+0x3c46780,
-   0 until the co-op module made it with the game's malloc (lichii/hook/coop_counters.h). Ring: +0 a u32 count, +8 256
-   u64 nodes; the node goes at (count + 1) % 256 and the count goes up. The module reads it a few times a second and
-   checks every node itself (vtable, actor), so a lost or doubled entry costs nothing; no lock, as on the emulator. */
-#include "hos.h"
-
-enum { COOP_RING_NODES = 256 };
-#define COOP_MAIN 0x80020000ull
-#define COOP_RING_POINTER (COOP_MAIN + 0x3c46780ull)
-
-void hos_coop_counter(uint64_t node) {
-    const uint64_t ring = G64(COOP_RING_POINTER);
-    if (!ring || !node) return;
-    const uint32_t n = G32(ring) + 1;
-    G32(ring) = n;
-    *(uint64_t *)GP(ring + 8 + 8ull * (n % COOP_RING_NODES)) = node;
-}
diff --git a/host/coop_world.c b/host/coop_world.c
new file mode 100644
index 0000000..8488288
--- /dev/null
+++ b/host/coop_world.c
@@ -0,0 +1,42 @@
+/* Co-op (oot-remake-multiplayer, GPL-3.0; its docs/hookshot.md "World hooks", patch 0005): the game's world events
+   straight to the co-op module.
+
+   Lift-time hooks (nx2/coop_platform_lift.py, more to come) call hos_coop_world_event at a game function. This hands
+   the event to the module's optional export hos_coop_world (hos_coop_world.h). The bridge (coop_bridge.c) loads the
+   module at the first frame hook; until then, without it, or with a module that has no such export, an event costs a
+   counter and nothing else. The export is kept only once the module says it is on (HOS_COOP_WORLD_HELLO answers 1):
+   a module the bridge refused and unloads never answers 1, and one that is on stays loaded until exit. */
+#if !defined(_WIN32) && !defined(_GNU_SOURCE)
+#define _GNU_SOURCE   /* (RTLD_DEFAULT) */
+#endif
+#include "hos_coop_world.h"
+#include <stddef.h>
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#else
+#include <dlfcn.h>
+#endif
+
+static hos_coop_world_fn world;   /* (atomic) the module's export, once it said it is on */
+static uint32_t wait;             /* (atomic) events until the next look for it */
+
+static hos_coop_world_fn find(void) {
+    if (__atomic_fetch_add(&wait, 1, __ATOMIC_RELAXED) % 256 != 0) return NULL;   /* (a look per 256 events) */
+#ifdef _WIN32
+    HMODULE m = GetModuleHandleA("hookshot_coop.dll");
+    hos_coop_world_fn f = m ? (hos_coop_world_fn)(void *)GetProcAddress(m, "hos_coop_world") : NULL;
+#else
+    void *m = dlopen("hookshot_coop.so", RTLD_NOW | RTLD_NOLOAD);
+    hos_coop_world_fn f = (hos_coop_world_fn)(m ? dlsym(m, "hos_coop_world") : dlsym(RTLD_DEFAULT, "hos_coop_world"));
+#endif
+    if (!f || f(HOS_COOP_WORLD_HELLO, 0, 0) != 1) return NULL;
+    __atomic_store_n(&world, f, __ATOMIC_RELEASE);
+    return f;
+}
+
+void hos_coop_world_event(uint32_t event, uint64_t a, uint64_t b) {
+    hos_coop_world_fn f = __atomic_load_n(&world, __ATOMIC_ACQUIRE);
+    if (!f && !(f = find())) return;
+    f(event, a, b);
+}
diff --git a/host/hos_coop_world.h b/host/hos_coop_world.h
new file mode 100644
index 0000000..ab6840b
--- /dev/null
+++ b/host/hos_coop_world.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Co-op's world hooks on Hookshot (oot-remake-multiplayer, docs/hookshot.md "World hooks"; our patch 0005).
+
+   On the emulator co-op learns what the game does in its world through code caves patched into the game (the pause
+   counters' cave, lichii/hook/coop_counter.s, fills a ring in the game's heap). On Hookshot the game is C: a lift-time
+   hook at the game function calls hos_coop_world_event (Hookshot's host/coop_world.c), which hands the event to the
+   module's optional export hos_coop_world. No guest memory, no cave, no game call.
+
+   The same file is in Hookshot's host/ through our patch 0005 and in our repository (hookshot/src): keep them equal
+   (tests/hookshot/module_test.cpp checks it). Plain C. */
+#ifndef HOS_COOP_WORLD_H
+#define HOS_COOP_WORLD_H
+#include <stdint.h>
+
+/* Events. a and b as listed; a new event takes the next number, an old module answers 0 to one it does not know. */
+#define HOS_COOP_WORLD_HELLO 0u           /* asked by Hookshot before it keeps the export: 1 once the module is on */
+#define HOS_COOP_WORLD_COUNTER_START 1u   /* main+0x5e6760 started an AI ExecuteGenericCounter: a = the node */
+
+/* The module's export (extern "C"). Called on the game thread that ran the hooked function (not always the calc
+   thread): it must be quick, take no lock the game waits on, and not call the game. Returns 1 when taken. */
+typedef int (*hos_coop_world_fn)(uint32_t event, uint64_t a, uint64_t b);
+
+#endif
diff --git a/nx2/coop_platform_lift.py b/nx2/coop_platform_lift.py
index 9c9944b..4d5c73f 100644
--- a/nx2/coop_platform_lift.py
+++ b/nx2/coop_platform_lift.py
@@ -3,10 +3,10 @@ counters"; method and addresses from Hot Onion).
 
 main+0x5e6760 starts an AI ExecuteGenericCounter node (x0 = the node), the timer of each pause between two moves of a
 looping platform (Dodongo's Cavern's lifts), each time the AI graph enters it. On the emulator co-op patches its first
-word into a jump to a small cave (lichii/hook/coop_counter.s) that puts the node into a ring in the game's heap. Here:
-C after `mov x19, x0` (main+0x5e6778, the end of the prologue) puts x0 into that same ring through
-host/coop_platform_ring.c. The co-op module makes the ring (the game's malloc) and writes its address at
-main+0x3c46780; until then, and without the module, nothing is written.
+word into a jump to a small cave (lichii/hook/coop_counter.s) that puts the node into a ring in the game's heap. Here
+(patch 0005, the world hooks): C after `mov x19, x0` (main+0x5e6778, the end of the prologue) hands x0 to the co-op
+module through host/coop_world.c (hos_coop_world.h, HOS_COOP_WORLD_COUNTER_START); the module keeps the node in a ring
+of its own. No guest ring, no game malloc. Without the module nothing is done.
 
 The words are checked and the build id; another game version leaves the hook out.
