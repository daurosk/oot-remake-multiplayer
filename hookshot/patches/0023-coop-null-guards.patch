diff --git a/nx2/coop_null_guards.py b/nx2/coop_null_guards.py
new file mode 100644
index 00000000..7ceb1582
--- /dev/null
+++ b/nx2/coop_null_guards.py
@@ -0,0 +1,119 @@
+"""Co-op's null guards (oot-remake-multiplayer's patch 0023, its docs/hookshot.md "Null reads").
+
+A co-op puppet (CoopPuppet_*) is a stripped copy of Link: it has no Player component (the one main+0x82acc0 returns,
+[[actor+0x270]+0x358]) and no component in slot 10 ([actor+0x270]+0x50). Code of the game that runs for the puppet, or
+for an item it wears, loads through those null pointers. On the emulator such a read gives 0 and the game takes its own
+"nothing there" branch; on Hookshot it is a host read and the game crashes ("guest 0x7d8", "guest 0x20", "guest 0xe58"),
+and on a real Switch it faults too. Patch 0002 maps a zero page under the guest's first MB to hide that; these guards
+make the page unneeded: each listed load runs only when its base register holds a real pointer, otherwise its register
+gets 0, exactly the value the emulator's read gives (a64_lift.py Lifter.unless). Nothing else changes: Link, who has
+both components, runs as shipped, and the shipped game crashes in the other case.
+
+The loads, in main of e0f3ccfaf50065ae (Ocarina of Time 1.1.1):
+- After `bl main+0x82acc0` (the wearer's Player component), every load through x0 that comes straight after the call
+  with no check: the 25 of the call's 110 callers that do so. Three were seen in players' and lane logs (main+0x2dceef8
+  in the item update f_82deee60, "guest 0x7d8"; main+0x26cf2a4 in f_826ef260, "guest 0xe58"); the rest read the same
+  missing component the same way. One more (review): main+0x27975f0, ldrb w8, [x0, #0x7c1], reached from the call at
+  main+0x27975d0 by a tbz over two instructions that leave x0 alone.
+  main+0x2dceef8 (the bow's wearer) is also met first by patch 0038 (nx2/coop_puppet_bow_guard.py), which takes the
+  game's own way out for a wearer with no Player component; this guard stays as the backstop when 0038 is left out.
+- Slot 10 in f_804d84b0 (main+0x4b85e4..0x4b85ec): the chain [table+0x50] -> +0x20 -> +0x1c8 before its own cbz; a
+  player's game crashed there ("guest 0x20", lr main+0x4b85e0) before patch 0002's guard had switched the zero page
+  on. Patch 0002 guards the same chain in main+0x4b8240 already. Slot 10 is read unchecked at 574 places in main, so it
+  is not guarded everywhere: only where a puppet was seen to go.
+
+Each load's word is checked (it must be the listed LDR/LDRB/LDRH with an immediate offset) and, for the Player ones,
+that the instruction before it calls main+0x82acc0; and the build id. A changed word leaves that one guard out; another
+build leaves them all out. The first few times each guard is used it says so in the log.
+"""
+
+MAIN = 0x80020000
+BUILD_ID = "e0f3ccfaf50065ae4ea01eb5aeb13b1a45da3348"
+PLAYER_OF = 0x82acc0     # [[x0+0x270]+0x358]: the actor's Player component, 0 when it has none
+NULL_BELOW = 0x100000    # Hookshot leaves the guest's first MB unmapped: a base below it is a null pointer
+
+# (main offset, its word): loads through x0 straight after `bl main+0x82acc0`
+PLAYER_LOADS = (
+    (0x82ac1c, 0xf9400c08), (0x84a070, 0x3940b008), (0x26cf2a4, 0xb94e5814), (0x2731e50, 0x39797c08),
+    (0x2733184, 0x39796808), (0x2794cf8, 0x3940c808), (0x27d470c, 0xb95be008), (0x27e4f6c, 0xf9400c08),
+    (0x27fa83c, 0xb94e4408), (0x27fca9c, 0x39792008), (0x27fed04, 0x3978e408), (0x27ff61c, 0x3978e408),
+    (0x280c6ec, 0x3940b808), (0x2b3093c, 0x3940c008), (0x2b30b70, 0xb9472c08), (0x2b37314, 0xf9400c08),
+    (0x2dceef8, 0xb947d808), (0x2eae030, 0xb947d808), (0x2f49fd0, 0xb947d808), (0x2f49fe4, 0x39408c08),
+    (0x2f9f9c0, 0x39797008), (0x2fa0e44, 0x39796c08), (0x2fa0ee8, 0x39796c08), (0x30507a0, 0x3940b008),
+    (0x3050874, 0x3940b008),
+)
+# (main offset, its word, the `bl main+0x82acc0` before it, the words between that leave x0 alone): a load reached from the
+# call by a branch. main+0x27975f0 sits after a retab; only the tbz at main+0x27975d8 goes there (whole main scanned)
+PLAYER_LOADS_LATER = (
+    (0x27975f0, 0x395f0408, 0x27975d0, ((0x27975d4, 0x394422a8),    # ldrb w8, [x21, #0x108]
+                                         (0x27975d8, 0x360000c8))),  # tbz w8, #0, main+0x27975f0
+)
+# (main offset, its word): slot 10 in f_804d84b0
+SLOT10_LOADS = ((0x4b85e4, 0xf9402908), (0x4b85e8, 0xf9401108), (0x4b85ec, 0xf940e508))
+
+# LDR (64/32), LDRH, LDRB with an unsigned immediate offset: (mask, value, bytes)
+_LOADS = ((0xffc00000, 0xf9400000, 8), (0xffc00000, 0xb9400000, 4), (0xffc00000, 0x79400000, 2),
+          (0xffc00000, 0x39400000, 1))
+
+
+def decode(word):
+    """(dest register, base register, offset) of a load the guards know, else None"""
+    for mask, value, size in _LOADS:
+        if word & mask == value:
+            return word & 31, (word >> 5) & 31, ((word >> 10) & 0xfff) * size
+    return None
+
+
+def calls(word, pc, target):
+    """True when `word` at main offset pc is `bl main+target`"""
+    if word is None or word >> 26 != 0x25:
+        return False
+    imm = word & 0x3ffffff
+    if imm & (1 << 25):
+        imm -= 1 << 26
+    return pc + imm * 4 == target
+
+
+def text(off, word):
+    """(condition, C instead) for Lifter.unless: the load's register gets 0 when its base is a null pointer"""
+    rt, rn, imm = decode(word)
+    put = "c->x[%d] = 0; " % rt if rt != 31 else ""
+    return ("c->x[%d] < 0x%xULL" % (rn, NULL_BELOW),
+            "%s{ extern void hos_log(const char *fmt, ...); static volatile long said; if (said++ < 4) "
+            "hos_log(\"coop: null guard at main+%#x: a read through a null x%d (+%#x) gives 0, as on the emulator "
+            "(nx2/coop_null_guards.py)\"); }" % (put, off, rn, imm))
+
+
+def _word(img, pc):
+    try:
+        return img.word(pc)
+    except Exception:
+        return None
+
+
+def install(lifter, img, build_id):
+    """The guards into lifter.unless; a load whose words differ is left out, another build leaves them all out.
+    Returns how many went in."""
+    if build_id != BUILD_ID:
+        print("co-op null guards: build %s is not %s: left out" % (build_id or "?", BUILD_ID))
+        return 0
+    n = 0
+    later = tuple((off, want) for off, want, _, _ in PLAYER_LOADS_LATER)
+    between = {off: (call, words) for off, _, call, words in PLAYER_LOADS_LATER}
+    for group, loads in (("player", PLAYER_LOADS + later), ("slot 10", SLOT10_LOADS)):
+        for off, want in loads:
+            have = _word(img, MAIN + off)
+            call, words = between.get(off, (off - 4, ()))
+            if have != want or decode(want) is None or (group == "player" and (
+                    not calls(_word(img, MAIN + call), call, PLAYER_OF)
+                    or any(_word(img, MAIN + o) != w for o, w in words))):
+                print("co-op null guards: main+%#x (%s) is not the code it was made for: left out" % (off, group))
+                continue
+            if MAIN + off in lifter.unless:
+                print("co-op null guards: main+%#x has a guard already: left out" % off)
+                continue
+            lifter.unless[MAIN + off] = text(off, want)
+            n += 1
+    print("co-op null guards: %d of %d loads guarded (a null base reads 0, as on the emulator)" % (
+        n, len(PLAYER_LOADS) + len(PLAYER_LOADS_LATER) + len(SLOT10_LOADS)))
+    return n
diff --git a/tests/test_coop_null_guards.py b/tests/test_coop_null_guards.py
new file mode 100644
index 00000000..e8e56097
--- /dev/null
+++ b/tests/test_coop_null_guards.py
@@ -0,0 +1,273 @@
+"""Game-free tests of co-op's null guards (nx2/coop_null_guards.py and a64_lift.py's Lifter.unless, oot-remake-multiplayer's
+patch 0023).
+
+- The install, with a fake lifter and image: every load goes in for the build it was made for; a changed word, a Player
+  load whose call before it is not `bl main+0x82acc0`, a load that is there already, or another build leave it out.
+- The words: each is a load through x0 (Player) or the slot-10 chain (x8 to x8), as the docstring says.
+- A real a64_lift.Lifter over a made-up function (no translator, so no compiler): the guarded instruction is wrapped in
+  `if (<null base>) { <C instead> } else { ... }` and nothing else in the text changes.
+- The C, compiled into a small program (with $CC, else clang or gcc on PATH; skipped when there is none) around a
+  stand-in for the load: a null base gives 0 and a log line, a real pointer reads memory as shipped.
+
+python -I -B tests/test_coop_null_guards.py
+COOP_LONGSHOT_SOURCE=<patched source> python -I -B <this file elsewhere>
+"""
+import os
+import re
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+# (the source: this file's own tree, or COOP_LONGSHOT_SOURCE when the file is run from outside it, as
+# oot-remake-multiplayer's tools/hookshot/null_guards_test.py does on the kit's source, which ships no tests/)
+ROOT = Path(os.environ.get("COOP_LONGSHOT_SOURCE") or Path(__file__).resolve().parents[1])
+sys.path.insert(0, str(ROOT / "nx2"))
+import kit  # noqa: E402,F401  (a64-kit on the path)
+import a64_lift  # noqa: E402
+import coop_null_guards as g  # noqa: E402
+
+
+def bl(pc, target):
+    return 0x94000000 | (((target - pc) >> 2) & 0x3FFFFFF)
+
+
+def game_words():
+    """The listed words, and `bl main+0x82acc0` before each Player load (main offsets)"""
+    words = {off: w for off, w in g.PLAYER_LOADS + g.SLOT10_LOADS}
+    for off, _ in g.PLAYER_LOADS:
+        words[off - 4] = bl(off - 4, g.PLAYER_OF)
+    for off, w, call, between in g.PLAYER_LOADS_LATER:
+        words[off] = w
+        words[call] = bl(call, g.PLAYER_OF)
+        words.update(between)
+    return words
+
+
+class Image:
+    def __init__(self, words):
+        self.words = words
+
+    def word(self, pc):
+        return self.words[pc - g.MAIN]
+
+
+class FakeLifter:
+    def __init__(self, unless=None):
+        self.unless = dict(unless or {})
+
+
+LATER = tuple((off, w) for off, w, _, _ in g.PLAYER_LOADS_LATER)
+ALL = g.PLAYER_LOADS + LATER + g.SLOT10_LOADS
+
+
+class InstallTests(unittest.TestCase):
+    def test_all_go_in(self):
+        lifter = FakeLifter()
+        self.assertEqual(g.install(lifter, Image(game_words()), g.BUILD_ID), len(ALL))
+        self.assertEqual(sorted(lifter.unless), sorted(g.MAIN + off for off, _ in ALL))
+        cond, instead = lifter.unless[g.MAIN + 0x2dceef8]
+        self.assertEqual(cond, "c->x[0] < 0x100000ULL")
+        self.assertTrue(instead.startswith("c->x[8] = 0; "))
+        self.assertIn("main+0x2dceef8", instead)
+        cond, instead = lifter.unless[g.MAIN + 0x26cf2a4]
+        self.assertTrue(instead.startswith("c->x[20] = 0; "))
+        cond, instead = lifter.unless[g.MAIN + 0x4b85e8]
+        self.assertEqual(cond, "c->x[8] < 0x100000ULL")
+
+    def test_another_build_is_left_out(self):
+        lifter = FakeLifter()
+        self.assertEqual(g.install(lifter, Image(game_words()), "0" * 40), 0)
+        self.assertEqual(lifter.unless, {})
+
+    def test_a_changed_word_leaves_that_one_out(self):
+        for off, _ in ALL:
+            words = game_words()
+            words[off] ^= 1 << 10   # (another offset: the same kind of load, not the same code)
+            lifter = FakeLifter()
+            self.assertEqual(g.install(lifter, Image(words), g.BUILD_ID), len(ALL) - 1, hex(off))
+            self.assertNotIn(g.MAIN + off, lifter.unless)
+
+    def test_a_player_load_needs_its_call(self):
+        for off, _ in g.PLAYER_LOADS:
+            words = game_words()
+            words[off - 4] = bl(off - 4, g.PLAYER_OF + 4)
+            lifter = FakeLifter()
+            self.assertEqual(g.install(lifter, Image(words), g.BUILD_ID), len(ALL) - 1, hex(off))
+            self.assertNotIn(g.MAIN + off, lifter.unless)
+
+    def test_a_later_load_needs_its_call_and_the_words_between(self):
+        off, _, call, between = g.PLAYER_LOADS_LATER[0]
+        self.assertEqual((off, call), (0x27975f0, 0x27975d0))
+        cases = [(call, bl(call, g.PLAYER_OF + 4))] + [(o, w ^ 1) for o, w in between]
+        for at, word in cases:
+            words = game_words()
+            words[at] = word
+            lifter = FakeLifter()
+            self.assertEqual(g.install(lifter, Image(words), g.BUILD_ID), len(ALL) - 1, hex(at))
+            self.assertNotIn(g.MAIN + off, lifter.unless)
+        lifter = FakeLifter()
+        g.install(lifter, Image(game_words()), g.BUILD_ID)
+        cond, instead = lifter.unless[g.MAIN + off]
+        self.assertEqual(cond, "c->x[0] < 0x100000ULL")
+        self.assertTrue(instead.startswith("c->x[8] = 0; "))
+
+    def test_a_word_that_cannot_be_read_is_left_out(self):
+        words = game_words()
+        del words[0x2dceef8]
+        lifter = FakeLifter()
+        self.assertEqual(g.install(lifter, Image(words), g.BUILD_ID), len(ALL) - 1)
+
+    def test_keeps_a_guard_that_is_there(self):
+        pc = g.MAIN + 0x2dceef8
+        lifter = FakeLifter({pc: ("0", "/* another */")})
+        self.assertEqual(g.install(lifter, Image(game_words()), g.BUILD_ID), len(ALL) - 1)
+        self.assertEqual(lifter.unless[pc], ("0", "/* another */"))
+
+
+class WordTests(unittest.TestCase):
+    def test_player_loads_read_through_x0(self):
+        offs = [off for off, _ in g.PLAYER_LOADS + LATER]
+        self.assertEqual(len(offs), len(set(offs)))
+        self.assertEqual(len(ALL), 29)
+        for off, w in g.PLAYER_LOADS + LATER:
+            rt, rn, imm = g.decode(w)
+            self.assertEqual(rn, 0, hex(off))
+            self.assertNotEqual(rt, 0, hex(off))   # (the guard's condition reads the base after nothing wrote it)
+        self.assertEqual(g.decode(0xb947d808), (8, 0, 0x7d8))      # ldr w8, [x0, #0x7d8]
+        self.assertEqual(g.decode(0xb94e5814), (20, 0, 0xe58))     # ldr w20, [x0, #0xe58]
+        self.assertEqual(g.decode(0x39797c08), (8, 0, 0xe5f))      # ldrb w8, [x0, #0xe5f]
+        self.assertEqual(g.decode(0x395f0408), (8, 0, 0x7c1))      # ldrb w8, [x0, #0x7c1]
+
+    def test_the_words_between_leave_x0_alone(self):
+        for off, _, call, between in g.PLAYER_LOADS_LATER:
+            # (every instruction from the call to the branch is listed)
+            self.assertEqual([o for o, _ in between], list(range(call + 4, call + 4 + 4 * len(between), 4)))
+            for o, w in between:
+                self.assertNotEqual(w & 31, 0, hex(o))   # (no instruction between writes x0)
+            tbz = between[-1][1]
+            self.assertEqual(tbz & 0x7f000000, 0x36000000)
+            self.assertEqual(between[-1][0] + ((tbz >> 5) & 0x3fff) * 4, off)
+
+    def test_slot10_chain(self):
+        self.assertEqual([g.decode(w) for _, w in g.SLOT10_LOADS], [(8, 8, 0x50), (8, 8, 0x20), (8, 8, 0x1c8)])
+        self.assertEqual([off for off, _ in g.SLOT10_LOADS], [0x4b85e4, 0x4b85e8, 0x4b85ec])
+
+    def test_only_plain_loads(self):
+        self.assertIsNone(g.decode(0xaa0003f7))   # mov x23, x0
+        self.assertIsNone(g.decode(0xf8408c08))   # ldr x8, [x0, #8]! (writes its base back)
+        self.assertTrue(g.calls(bl(0x100, 0x82acc0), 0x100, 0x82acc0))
+        self.assertFalse(g.calls(0xaa0003f7, 0x100, 0x82acc0))
+        self.assertFalse(g.calls(None, 0x100, 0x82acc0))
+
+
+BASE = 0x80000000
+FN = BASE + 0x1000
+RET = 0xd65f03c0
+ADD = 0x91000400            # add x0, x0, #1
+LOAD = 0xb947d808           # ldr w8, [x0, #0x7d8]
+FN_WORDS = {FN: ADD, FN + 4: LOAD, FN + 8: ADD, FN + 12: RET}
+
+
+class FnImage:
+    entries = {FN}
+    hooks = {}
+    names = {}
+
+    def word(self, pc):
+        return FN_WORDS[pc]
+
+    def in_code(self, pc):
+        return pc in FN_WORDS
+
+    def read(self, pc, n):
+        return b"".join(struct.pack("<I", FN_WORDS[pc + 4 * i]) for i in range(n // 4))
+
+
+def fn_texts():
+    return {ADD: ("    c->x[0] += 1;", 0), LOAD: ("    c->x[8] = LOAD32(c->x[0] + 0x7d8);", 0)}
+
+
+class LifterTests(unittest.TestCase):
+    def emit(self, unless):
+        lifter = a64_lift.Lifter(FnImage())
+        lifter.discover()
+        lifter.unless.update(unless)
+        return lifter.emit_function(FN, fn_texts())[0]
+
+    def test_unguarded_is_unchanged(self):
+        self.assertEqual(self.emit({}), self.emit({BASE + 0x9999: ("1", "")}))
+
+    def test_wraps_only_the_load(self):
+        plain = self.emit({}).splitlines()
+        text = self.emit({FN + 4: ("c->x[0] < 0x100000ULL", "c->x[8] = 0;")}).splitlines()
+        i = plain.index("    c->x[8] = LOAD32(c->x[0] + 0x7d8);")
+        self.assertEqual(text[:i], plain[:i])
+        self.assertEqual(text[i:i + 3], ["if (c->x[0] < 0x100000ULL) { c->x[8] = 0; } else {",
+                                         "    c->x[8] = LOAD32(c->x[0] + 0x7d8);", "}"])
+        self.assertEqual(text[i + 3:], plain[i + 1:])
+        self.assertEqual(sum(1 for line in text if re.search(r"c->x\[0\] \+= 1;", line)), 2)
+
+
+HARNESS = r"""
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+typedef struct { uint64_t x[32]; } Ctx;
+static uint8_t mem[0x200000];
+static int said;
+void hos_log(const char *fmt, ...) { if (strstr(fmt, "%s")) said++; }
+static uint64_t LOAD(uint64_t a, int n) { uint64_t v = 0; memcpy(&v, mem + a, n); return v; }
+static void run(Ctx *c) {
+    if (%s) { %s } else { c->x[%d] = LOAD(c->x[%d] + %#x, %d); }
+}
+int main(void) {
+    Ctx c;
+    memset(&c, 0, sizeof c); c.x[%d] = 7; c.x[%d] = 0;   /* (the base last: it may be the same register) */
+    run(&c);
+    if (c.x[%d] != 0 || said != 1) return 1;
+    memset(mem + 0x100000 + %#x, 0x5a, 8);
+    memset(&c, 0, sizeof c); c.x[%d] = 7; c.x[%d] = 0x100000;
+    run(&c);
+    if (c.x[%d] == 0 || c.x[%d] == 7 || said != 1) return 2;
+    puts("ok");
+    return 0;
+}
+"""
+
+
+def compiler():
+    for cc in (os.environ.get("CC"), "clang", "gcc", "cc"):
+        if cc and shutil.which(cc):
+            return shutil.which(cc)
+    return None
+
+
+@unittest.skipUnless(compiler(), "no C compiler ($CC, clang or gcc)")
+class EmittedCTests(unittest.TestCase):
+    def test_reads_as_the_emulator_does(self):
+        lifter = FakeLifter()
+        g.install(lifter, Image(game_words()), g.BUILD_ID)
+        sizes = {0xf9400000: 8, 0xb9400000: 4, 0x79400000: 2, 0x39400000: 1}
+        for off, w in (ALL[0], (0x2dceef8, 0xb947d808), (0x26cf2a4, 0xb94e5814), LATER[0], g.SLOT10_LOADS[1]):
+            rt, rn, imm = g.decode(w)
+            cond, instead = lifter.unless[g.MAIN + off]
+            marker = "main+%#x" % off
+            src = HARNESS.replace('strstr(fmt, "%s")', 'strstr(fmt, "' + marker + '")') % (
+                cond, instead, rt, rn, imm, sizes[w & 0xffc00000], rt, rn, rt, imm, rt, rn, rt, rt)
+            with tempfile.TemporaryDirectory() as d:
+                c = os.path.join(d, "t.c")
+                exe = os.path.join(d, "t.exe")
+                Path(c).write_text(src)
+                built = subprocess.run([compiler(), "-std=c11", "-Wall", "-Werror", c, "-o", exe],
+                                       capture_output=True, text=True)
+                self.assertEqual(built.returncode, 0, built.stderr + src)
+                r = subprocess.run([exe], capture_output=True, text=True)
+                self.assertEqual((r.returncode, r.stdout.strip()), (0, "ok"), hex(off))
+
+
+if __name__ == "__main__":
+    unittest.main()
