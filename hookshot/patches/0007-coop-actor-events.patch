From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: coop-fetch <coop-fetch@localhost>
Date: Thu, 12 Nov 2026 13:30:00 -0900
Subject: [PATCH] Co-op actor events: creates, deletes and the Life step go to
 the module

nx2/coop_actor_lift.py adds four lift-time hooks that hand actor
events to the co-op module through host/coop_world.c (patch 0005):
the create request (main+0x372a94: CREATE_FROM with the caller and the
create argument, then CREATE_REQUEST with the name and the handle
slot, then CREATE_STOP, with which the module may have the request
leave through the game's own "no creates now" exit), the delete request once it is accepted (main+0xa65d0:
DELETE_REQUEST with the actor and the reason, once for an actor) and
the Life component's step (main+0x49dcb0: LIFE_STEP with the component
and this frame's damage sum, which the module may change, so another
player's hit goes in through the game's own step). The words and the
build id are checked; a hook whose words differ is left out. Their
install line goes right after patch 0005's, so the patch applies with or
without the patches numbered between them.
The fourth is the game's shoot code (main+0xc16d24: SHOOT_FROM with
the shooter's actor, before the create it makes).
---
 nx2/coop_actor_lift.py | 103 +++++++++++++++++++++++++++++++++++++++++
 nx2/coop_hooks.py      |   2 +
 2 files changed, 105 insertions(+)
 create mode 100644 nx2/coop_actor_lift.py

diff --git a/nx2/coop_actor_lift.py b/nx2/coop_actor_lift.py
new file mode 100644
index 0000000..7e67e39
--- /dev/null
+++ b/nx2/coop_actor_lift.py
@@ -0,0 +1,103 @@
+"""Co-op's actor events (oot-remake-multiplayer's patch 0007, its docs/hookshot.md "World hooks": enemies, breakables,
+drops and projectiles straight from the game's C).
+
+Four C hooks, each after one ordinary instruction in a game function, hand what the function was asked to
+do to the co-op module through host/coop_world.c (patch 0005), the same world hook layer as the pause counters. The
+event numbers are in the module's hookshot/src/hos_coop_actors.h:
+
+- main+0x372a70 requestCreateActorAsync: after `ldr x23, [x29, #0x68]` (main+0x372a94, the end of the prologue; the
+  arguments and the return address are still the caller's): 5 = CREATE_FROM (a = the return address, b = x2, the
+  create argument), then 2 = CREATE_REQUEST (a = x1, the name, b = x3, the handle slot the manager fills), then
+  6 = CREATE_STOP (a = the address of a uint32 in our C, 0). A module that sets it has the request leave through the
+  game's own "the manager takes no creates now" exit (main+0x372c88, where the function's first test goes when bit 1
+  of manager+0x109 is set: status 1 into the caller's word, returns 0), so the actor is never made: a copy enemy's
+  own shot, which only the enemy's owner fires.
+- main+0xa6490 the delete request: after `ldr x0, [x22]` (main+0xa65d0, reached once for an actor, when the request
+  is accepted: the function has just set bit 16 of actor+0x30 and found it clear; a request for an actor already
+  being deleted, a refused one and a repeated one never get there): 3 = DELETE_REQUEST (a = x19, the actor,
+  b = x20, the reason).
+- main+0x49d8c0 the Life component's step: after `add w9, w10, w9` (main+0x49dcb0: w9 = the damage dealt to it this
+  frame, before it is stored at +0x1cb0 and taken off life. A step reaches it unless it leaves early: bits 3 and 12
+  of Life+0x1d18 set, or no life value at Life+0x1c10; on those frames there is no event): 4 = LIFE_STEP
+  (a = the Life component, b = the address of an int32 holding w9 in our C). The module may change that number: a hit
+  from another player goes in through the game's own step (its clamp, its death, its drop), and w9 takes the result.
+
+- main+0xc16cf0 the game's shoot code, which makes a shot with the create request at main+0xc172fc: after
+  `mov x22, x1` (main+0xc16d24): 7 = SHOOT_FROM (a = x1, whose first 8 bytes are the shooter's actor: each of its
+  three callers stores [its component + 0x18] there, b = x0, the shot record). The module then knows whose shot the
+  create that follows is.
+
+The module only reads in them (no game call, no lock), besides that one number and the create's stop. The words are checked and the build id; another game version, or
+a word that differs, leaves that hook out.
+"""
+
+MAIN = 0x80020000
+BUILD_ID = "e0f3ccfaf50065ae4ea01eb5aeb13b1a45da3348"
+EVENT = "extern void hos_coop_world_event(uint32_t event, uint64_t a, uint64_t b); "
+HOOKS = (
+    ("create request", 0x372a94,
+     ((0x372a70, 0xd503237f),   # pacibsp
+      (0x372a90, 0xd11383ff),   # sub sp, sp, #0x4e0
+      (0x372a94, 0xf94037b7),   # ldr x23, [x29, #0x68]
+      (0x372a98, 0x39442408),   # ldrb w8, [x0, #0x109]: the manager's "no creates" bit
+      (0x372a9c, 0x37080f68),   # tbnz w8, #1, main+0x372c88: set, so no create
+      (0x372c88, 0xb4000137),   # cbz x23, main+0x372cac: no status word
+      (0x372c8c, 0x52800028),   # mov w8, #1: the status
+      (0x372c90, 0x2a1f03e0)),  # mov w0, wzr
+     "{ uint32_t coop_stop = 0; " + EVENT +
+     "hos_coop_world_event(5u, c->x[30], c->x[2]); hos_coop_world_event(2u, c->x[1], c->x[3]); "
+     "hos_coop_world_event(6u, (uint64_t)(uintptr_t)&coop_stop, 0); if (coop_stop) goto L_80392c88; }   "
+     "/* (nx2/coop_actor_lift.py: co-op's actor events, 5 = CREATE_FROM, 2 = CREATE_REQUEST, 6 = CREATE_STOP) */"),
+    ("delete request", 0xa65d0,
+     ((0xa64a0, 0xd503237f),    # pacibsp
+      (0xa64bc, 0xaa0003f3),    # mov x19, x0
+      (0xa64c4, 0xaa0103f4),    # mov x20, x1
+      (0xa65c8, 0xb8293108),    # ldset w9, w8, [x8]: bit 16 of actor+0x30, "delete asked"
+      (0xa65cc, 0x37800128),    # tbnz w8, #0x10: it was set already
+      (0xa65d0, 0xf94002c0),    # ldr x0, [x22]
+      (0xa65d4, 0xaa1303e1)),   # mov x1, x19
+     "{ " + EVENT + "hos_coop_world_event(3u, c->x[19], c->x[20]); }   "
+     "/* (nx2/coop_actor_lift.py: co-op's actor events, 3 = DELETE_REQUEST) */"),
+    ("life step", 0x49dcb0,
+     ((0x49dcac, 0x0b0b014a),   # add w10, w10, w11
+      (0x49dcb0, 0x0b090149),   # add w9, w10, w9: the frame's damage sum
+      (0x49dcb4, 0xb940726a),   # ldr w10, [x19, #0x70]
+      (0x49dcb8, 0xb91cb269)),  # str w9, [x19, #0x1cb0]
+     "{ int32_t coop_sum = (int32_t)(uint32_t)c->x[9]; " + EVENT +
+     "hos_coop_world_event(4u, c->x[19], (uint64_t)(uintptr_t)&coop_sum); c->x[9] = (uint32_t)coop_sum; }   "
+     "/* (nx2/coop_actor_lift.py: co-op's actor events, 4 = LIFE_STEP) */"),
+    ("shoot", 0xc16d24,
+     ((0xc16cf0, 0xd503237f),   # pacibsp
+      (0xc16d18, 0xaa0003f4),   # mov x20, x0
+      (0xc16d20, 0xaa0203f5),   # mov x21, x2
+      (0xc16d24, 0xaa0103f6),   # mov x22, x1
+      (0xc172fc, 0x97dd6ddd)),  # bl main+0x372a70: the shot's create request
+     "{ " + EVENT + "hos_coop_world_event(7u, c->x[1], c->x[0]); }   "
+     "/* (nx2/coop_actor_lift.py: co-op's actor events, 7 = SHOOT_FROM) */"),
+)
+
+
+def _word(img, pc):
+    try:
+        return img.word(pc)
+    except Exception:
+        return None
+
+
+def install(lifter, img, build_id):
+    """The hooks into lifter.after; each left out when the build or one of its words differs. Returns how many went in."""
+    if build_id != BUILD_ID:
+        return 0
+    n = 0
+    for name, site, words, text in HOOKS:
+        bad = next(((off, want, _word(img, MAIN + off)) for off, want in words if _word(img, MAIN + off) != want), None)
+        if bad:
+            off, want, have = bad
+            print("co-op actors: %s: main+%#x holds %s, not %08x: left out" % (
+                name, off, "?" if have is None else "%08x" % have, want))
+            continue
+        pc = MAIN + site
+        lifter.after[pc] = (lifter.after[pc] + "\n" if pc in lifter.after else "") + text
+        n += 1
+    print("co-op actors: %d of %d actor event hooks (world hook)" % (n, len(HOOKS)))
+    return n
diff --git a/nx2/coop_hooks.py b/nx2/coop_hooks.py
index 5f5a5f3..2d0ffda 100644
--- a/nx2/coop_hooks.py
+++ b/nx2/coop_hooks.py
@@ -63,6 +63,8 @@ def install(lifter, img, build_id):
     # installs below add, so its place among them does not matter)
     import coop_world_wraps
     coop_world_wraps.install(lifter, img, build_id)
+    import coop_actor_lift   # (patch 0007: enemies, breakables, drops, projectiles)
+    coop_actor_lift.install(lifter, img, build_id)
     import coop_puppet_guard   # (patch 0002: the other players' Link)
     coop_puppet_guard.install(lifter, img, build_id)
     import coop_platform_lift   # (patch 0003: looping platforms' pause counters)
-- 
