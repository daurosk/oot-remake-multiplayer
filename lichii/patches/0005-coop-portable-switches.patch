From 0a72d94b59ef9e78687ccba30c42706d9b59cd2f Mon Sep 17 00:00:00 2001
From: daurosk <354202035+daurosk@users.noreply.github.com>
Date: Tue, 10 Nov 2026 15:02:58 -0900
Subject: [PATCH] coop: a portable kit reads only its own nx2_switches.txt

Fritchii reads nx2_switches.txt beside the exe and then the one in
%APPDATA%\fritchii (v5.8; eden before). An OoT co-op kit is portable
(user\ beside lichii.exe) and must stay apart from the player's normal
install, so with a user\ folder only the kit's own file is read.
---
 src/yuzu/main.cpp | 21 +++++++++++++++------
 1 file changed, 15 insertions(+), 6 deletions(-)

diff --git a/src/yuzu/main.cpp b/src/yuzu/main.cpp
index 42d2b18dce..21a464ae50 100644
--- a/src/yuzu/main.cpp
+++ b/src/yuzu/main.cpp
@@ -428,12 +428,21 @@ static void LoadNx2Switches(const char* argv0) {
         ParseSwitchFile(exe_dir / "nx2_switches.txt", file);
         take(std::move(file), 2);
     }
-    auto user_file = Nx2UserSwitchFile();
-    if (!std::filesystem::exists(user_file)) {
-        user_file = Nx2LegacyUserSwitchFile();
-    }
-    const std::string hybrid_note = RetireHybridCoresOff(user_file);
-    {
+    // OoT co-op: a portable kit (user\ beside the exe) reads only its own switches, never the
+    // player's normal install's (%APPDATA%\fritchii or eden): the kit stays apart from it, and
+    // its retire-hybrid-cores rewrite never touches that file.
+    bool portable_kit = false;
+    if (const auto exe_dir = GetSwitchExeDirectory(argv0); !exe_dir.empty()) {
+        std::error_code portable_ec;
+        portable_kit = std::filesystem::is_directory(exe_dir / PORTABLE_DIR, portable_ec);
+    }
+    std::string hybrid_note;
+    if (!portable_kit) {
+        auto user_file = Nx2UserSwitchFile();
+        if (!std::filesystem::exists(user_file)) {
+            user_file = Nx2LegacyUserSwitchFile();
+        }
+        hybrid_note = RetireHybridCoresOff(user_file);
         std::map<std::string, std::string> file;
         ParseSwitchFile(user_file, file);
         take(std::move(file), 1);
